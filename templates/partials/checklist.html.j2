<!-- Manual Verification Checklist Section -->
{% if checklist and checklist.categories %}
<section id="checklist" class="section">
    <div class="section-label">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand-light)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span style="color: var(--brand-light);">MANUAL VERIFICATION CHECKLIST</span>
    </div>

    <div class="card" style="border-left: 3px solid var(--brand);">
        <p style="color: var(--text-secondary); margin-bottom: 14px; font-size: 12.5px;">The following items could not be fully automated and require manual verification by a security analyst.</p>

        <div style="display: flex; flex-direction: column; gap: 6px;">
            {% for cat in checklist.categories %}
                {% for item in cat.get('items', []) %}
            <div style="display: flex; gap: 10px; align-items: flex-start; padding: 10px; background: var(--surface); border-radius: var(--r-compact); border: 1px solid var(--border);">
                <input type="checkbox" style="margin-top: 3px; accent-color: var(--brand);">
                <div>
                    <div style="font-weight: 600; font-size: 12.5px; margin-bottom: 2px;">{{ item.task }}</div>
                    <div style="font-size: 11px; color: var(--text-tertiary);">Context: {{ item.context }}</div>
                    {% if item.module %}
                    <span class="pill" style="margin-top: 6px; font-size: 9px; text-transform: uppercase;">{{ item.module }}</span>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
            {% endfor %}
        </div>

        <div style="margin-top: 14px; text-align: right;">
            <button class="btn-ghost" onclick="window.printReport()">Print Report</button>
        </div>
    </div>
</section>
{% endif %}
