<!-- Manual Verification Checklist Section -->
{% if checklist and checklist.categories %}
<section id="checklist" class="section">
    <div class="section-header">
        <div style="font-size: 24px; color: var(--accent);">✅</div>
        <h2>MANUAL VERIFICATION CHECKLIST</h2>
    </div>

    <div class="card" style="border-left: 4px solid var(--accent);">
        <p style="color: var(--text-muted); margin-bottom: 16px;">The following items could not be fully automated and require manual verification by a security analyst.</p>
        
        <div style="display: flex; flex-direction: column; gap: 8px;">
            {% for cat in checklist.categories %}
                {% for item in cat.get('items', []) %}
            <div style="display: flex; gap: 12px; align-items: flex-start; padding: 12px; background: rgba(0,0,0,0.2); border-radius: 4px; border-left: 2px solid var(--border-light);">
                <input type="checkbox" style="margin-top: 4px; accent-color: var(--accent);">
                <div>
                    <div style="font-weight: 600; margin-bottom: 4px;">{{ item.task }}</div>
                    <div style="font-size: 12px; color: var(--text-muted);">Context: {{ item.context }}</div>
                    {% if item.module %}
                    <span class="pill" style="margin-top: 8px; font-size: 10px;">{{ item.module }}</span>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
            {% endfor %}
        </div>
        
        <div style="margin-top: 16px; text-align: right;">
            <button class="pill" style="background: var(--surface); color: var(--text); border-color: var(--border); cursor: pointer;" onclick="window.printReport()">🖨️ Print Report</button>
        </div>
    </div>
</section>
{% endif %}
