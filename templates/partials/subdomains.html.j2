<!-- Subdomains Card -->
{% if intel.subdomains %}
<div class="intel-card">
    <div class="intel-card-header" onclick="window.toggleCollapsible(this)" style="border-left: 2px solid #8b5cf6; color: var(--text-secondary);">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        SUBDOMAINS
        <span class="pill count-pill" style="font-size: 9px; padding: 1px 6px;">{{ intel.subdomains | length }}</span>
        <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
    <div class="intel-card-content">
        <div style="display: flex; flex-wrap: wrap; gap: 4px;">
            {% for sub in intel.subdomains[:20] %}
            {% set sub_name = sub.subdomain if sub.subdomain is defined else (sub.name if sub.name is defined else sub) %}
            <span class="pill" style="font-size: 10px; font-family: 'JetBrains Mono', monospace; padding: 3px 8px;">{{ sub_name }}</span>
            {% endfor %}
        </div>
        {% if intel.subdomains | length > 20 %}
        <div style="font-size: 10px; color: var(--text-tertiary); text-align: center; padding-top: 6px;">+ {{ intel.subdomains | length - 20 }} more subdomains</div>
        {% endif %}
    </div>
</div>
{% endif %}
