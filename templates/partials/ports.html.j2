<!-- Open Ports Card -->
{% if intel.open_ports %}
<div class="intel-card">
    <div class="intel-card-header" onclick="window.toggleCollapsible(this)" style="border-left: 2px solid #dc2626; color: var(--text-secondary);">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/></svg>
        OPEN PORTS
        <span class="pill count-pill" style="font-size: 9px; padding: 1px 6px; background: var(--sev-high-bg); color: var(--sev-high); border-color: var(--sev-high-bd);">{{ intel.open_ports | length }}</span>
        <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
    <div class="intel-card-content">
        <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px;">
            {% for port in intel.open_ports[:16] %}
            {% set is_risky = port.port in [22, 3389, 5432, 3306, 6379, 27017, 9200] or port.risk in ['risky', 'critical'] %}
            {% set is_web = port.port in [80, 443, 8080, 8443] %}
            <span class="pill" style="font-family: 'JetBrains Mono', monospace; font-size: 10px; padding: 3px 8px;
                {% if is_risky %}background: var(--sev-high-bg); border-color: var(--sev-high-bd); color: var(--sev-high);
                {% elif is_web %}background: var(--sev-low-bg); border-color: var(--sev-low-bd); color: var(--sev-low);
                {% else %}background: var(--sev-info-bg); border-color: var(--sev-info-bd); color: var(--sev-info);{% endif %}"
                title="{{ port.service or '' }}">
                {{ port.port }}{% if port.service %}/{{ port.service }}{% endif %}
            </span>
            {% endfor %}
        </div>
        {% if intel.open_ports | length > 16 %}
        <div style="font-size: 10px; color: var(--text-tertiary); text-align: center;">+ {{ intel.open_ports | length - 16 }} more ports</div>
        {% endif %}
    </div>
</div>
{% endif %}
