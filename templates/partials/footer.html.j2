<!-- Footer Section -->
<footer style="margin-top: 48px; padding: 36px 24px; border-top: 1px solid var(--border); background: var(--surface); text-align: center; color: var(--text-muted);">
    <div style="display: flex; justify-content: center; align-items: center; gap: 6px; margin-bottom: 12px;">
        <div style="width: 18px; height: 18px; border-radius: 3px; background: var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 9px; color: white;">PS</div>
        <span style="font-family: 'Syne', sans-serif; font-weight: 800; font-size: 13px; letter-spacing: 0.04em;">PHANTOMSCAN</span>
    </div>
    
    <p style="font-size: 11px; max-width: 560px; margin: 0 auto 20px auto; line-height: 1.55; color: var(--text-dim);">
        This report contains confidential information intended only for the authorized recipient. 
        The findings represented here are a point-in-time snapshot of the target's security posture 
        and may not reflect current conditions.
    </p>
    
    <div style="font-size: 10px; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; color: var(--text-dim);">
        <span>Generated: {{ scan.timestamp | format_date }}</span>
        <span>|</span>
        <span>Version: {{ report_version }}</span>
        <span>|</span>
        <span>Target: {{ scan.target }}</span>
    </div>

    {% if scan_metadata and (scan_metadata.circuit_breakers_opened or scan_metadata.degradation_active) %}
    <div style="max-width: 560px; margin: 14px auto 0 auto; background: var(--med-bg); border: 1px solid var(--med-border); border-radius: 4px; padding: 8px 12px; font-size: 10px; color: var(--med); text-align: left;">
        <div style="font-weight: 700; margin-bottom: 2px;">Notice &amp; Service Status</div>
        {% if scan_metadata.circuit_breakers_opened %}
        <div>&bull; <strong>Circuit Breakers Tripped:</strong> {{ scan_metadata.circuit_breakers_opened | join(', ') }}</div>
        {% endif %}
        {% if scan_metadata.degradation_active %}
        {% for msg in scan_metadata.degradation_active %}
        <div>&bull; {{ msg }}</div>
        {% endfor %}
        {% endif %}
    </div>
    {% endif %}

    <!-- Local LLM Endpoint Config for Embedded Chat (Module 14) -->
    <div class="interactive-only" style="max-width: 460px; margin: 20px auto 0 auto; background: var(--card); border: 1px solid var(--border); border-radius: 5px; padding: 14px; font-size: 11px;">
        <div style="font-weight: 700; color: var(--text); margin-bottom: 6px;">AI Assistant Settings</div>
        <div style="display: flex; gap: 6px;">
            <input type="text" id="llm-endpoint-input" placeholder="e.g. http://localhost:11434/api/chat (Ollama)" style="flex: 1; background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: 3px; padding: 5px 8px; font-size: 10px;" value="">
            <button class="btn" style="font-size: 10px;" onclick="window.saveLlmEndpoint()">Save</button>
        </div>
        <div style="color: var(--text-dim); font-size: 9px; margin-top: 4px; text-align: left;">
            Configures local Ollama endpoint for AI finding chat. If empty, falls back to static security FAQs.
        </div>
    </div>
</footer>

<script>
(function() {
    window.saveLlmEndpoint = function() {
        const input = document.getElementById('llm-endpoint-input');
        const val = input ? input.value.trim() : '';
        if (window.setStorage) window.setStorage('phantomscan_llm_endpoint', val);
        alert(val ? 'LLM Endpoint saved!' : 'Cleared LLM Endpoint (using static FAQs)');
    };

    window.askFindingQuestion = async function(index, findingId, title) {
        const input = document.getElementById('chat-input-' + index);
        const output = document.getElementById('chat-output-' + index);
        if (!input || !output) return;
        const question = input.value.trim();
        if (!question) return;

        output.innerHTML = 'Thinking...';
        const endpoint = window.getStorage ? window.getStorage('phantomscan_llm_endpoint', '') : '';

        if (!endpoint) {
            // Static FAQ Fallback
            let answer = "[Static FAQ] ";
            const q = question.toLowerCase();
            if (q.includes("why") || q.includes("severity")) {
                answer += "This finding was flagged because of security pattern match evidence in the endpoint response.";
            } else if (q.includes("fix") || q.includes("patch") || q.includes("remediat")) {
                answer += "Review the recommended patch steps above or consult OWASP/CWE references.";
            } else {
                answer += "Configure a local Ollama endpoint in settings below for full AI explanations.";
            }
            output.innerHTML = '<strong>A:</strong> ' + answer;
            input.value = '';
            return;
        }

        try {
            const resp = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    model: 'llama3',
                    messages: [
                        { role: 'system', content: 'You are a security analyst assistant. Answer concisely about finding: ' + title },
                        { role: 'user', content: question }
                    ]
                })
            });
            const data = await resp.json();
            output.innerHTML = '<strong>A:</strong> ' + (data.message?.content || JSON.stringify(data));
        } catch(e) {
            output.innerHTML = '<strong>A:</strong> [Static FAQ Fallback] ' + question;
        }
        input.value = '';
    };

    document.addEventListener('DOMContentLoaded', () => {
        if (window.getStorage) {
            const saved = window.getStorage('phantomscan_llm_endpoint', '');
            if (saved) {
                const input = document.getElementById('llm-endpoint-input');
                if (input) input.value = saved;
            }
        }
    });
})();
</script>
