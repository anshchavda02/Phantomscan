<!-- Footer Section -->
<footer style="margin-top: 48px; padding: 36px 24px; border-top: 1px solid var(--border); background: var(--surface); text-align: center; color: var(--text-secondary);">
    <div style="display: flex; justify-content: center; align-items: center; gap: 6px; margin-bottom: 12px;">
        <div style="width: 20px; height: 20px; border-radius: var(--r-sharp); background: var(--brand); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 9px; color: #ffffff; font-family: 'Syne', sans-serif;">PS</div>
        <span style="font-family: 'Syne', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: 0.04em; color: var(--text-primary);">PHANTOM<span style="color: var(--brand-light);">SCAN</span></span>
    </div>

    <p style="font-size: 11px; max-width: 560px; margin: 0 auto 16px auto; line-height: 1.55; color: var(--text-tertiary);">
        This security assessment report contains confidential information intended solely for authorized personnel.
        The findings represent a point-in-time assessment and may not reflect real-time infrastructure state.
    </p>

    <div style="font-size: 10px; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; color: var(--text-tertiary); margin-bottom: 20px;">
        <span>Generated: {{ scan.timestamp | format_date }}</span>
        <span>&middot;</span>
        <span>Version: {{ report_version }}</span>
        <span>&middot;</span>
        <span>Target: {{ scan.target }}</span>
    </div>

    {% if scan_metadata and (scan_metadata.circuit_breakers_opened or scan_metadata.degradation_active) %}
    <div style="max-width: 560px; margin: 14px auto; background: var(--sev-medium-bg); border: 1px solid var(--sev-medium-bd); border-radius: var(--r-compact); padding: 10px 14px; font-size: 11px; color: var(--sev-medium); text-align: left;">
        <div style="font-weight: 700; margin-bottom: 4px; font-family: 'Syne', sans-serif; font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em;">Notice &amp; Service Status</div>
        {% if scan_metadata.circuit_breakers_opened %}
        <div>&bull; <strong>Circuit Breakers Tripped:</strong> {{ scan_metadata.circuit_breakers_opened | join(', ') }}</div>
        {% endif %}
        {% if scan_metadata.degradation_active %}
        {% for msg in scan_metadata.degradation_active %}
        <div>&bull; {{ msg }}</div>
        {% endfor %}
        {% endif %}
    </div>
    {% endif %}

    <!-- Local LLM Endpoint Config for Embedded Chat -->
    <div class="interactive-only" style="max-width: 480px; margin: 20px auto 0 auto; background: var(--card); border: 1px solid var(--border); border-radius: var(--r-standard); padding: 14px; font-size: 11px; text-align: left;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <span style="font-weight: 700; color: var(--text-primary); font-family: 'Syne', sans-serif; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;">AI Assistant Endpoint</span>
            <span id="llm-save-status" style="font-size: 10px; color: var(--sev-low); font-weight: 600; opacity: 0; transition: opacity 0.2s;">SAVED</span>
        </div>
        <div style="display: flex; gap: 6px;">
            <input type="text" id="llm-endpoint-input" placeholder="http://localhost:11434/api/chat" style="flex: 1; background: var(--surface); border: 1px solid var(--border); color: var(--text-primary); border-radius: var(--r-compact); padding: 6px 10px; font-size: 11px; font-family: 'JetBrains Mono', monospace;" value="">
            <button class="btn-ghost" style="padding: 5px 12px; font-size: 11px;" onclick="window.saveLlmEndpoint()">Save</button>
        </div>
        <div style="color: var(--text-tertiary); font-size: 10px; margin-top: 6px;">
            Optional local Ollama / OpenAI-compatible endpoint. When unset, static security FAQs are used.
        </div>
    </div>
</footer>

<script>
(function() {
    window.saveLlmEndpoint = function() {
        const input = document.getElementById('llm-endpoint-input');
        const val = input ? input.value.trim() : '';
        if (window.setStorage) window.setStorage('phantomscan_llm_endpoint', val);
        const status = document.getElementById('llm-save-status');
        if (status) {
            status.textContent = val ? 'ENDPOINT SAVED' : 'CLEARED';
            status.style.opacity = '1';
            setTimeout(() => { status.style.opacity = '0'; }, 2000);
        }
    };

    window.askFindingQuestion = async function(index, findingId, title) {
        const input = document.getElementById('chat-input-' + index);
        const output = document.getElementById('chat-output-' + index);
        if (!input || !output) return;
        const question = input.value.trim();
        if (!question) return;

        output.innerHTML = '<div class="dot-loader"><span></span><span></span><span></span></div>';
        const endpoint = window.getStorage ? window.getStorage('phantomscan_llm_endpoint', '') : '';

        if (!endpoint) {
            let answer = "";
            const q = question.toLowerCase();
            if (q.includes("why") || q.includes("severity")) {
                answer = "This finding was flagged due to deterministic pattern match signatures matching known vulnerability classes.";
            } else if (q.includes("fix") || q.includes("patch") || q.includes("remediat")) {
                answer = "Apply standard mitigation: validate all inputs, restrict endpoint access, and consult the remediation section above.";
            } else {
                answer = "Configure a local Ollama or OpenAI-compatible endpoint in report settings for dynamic contextual analysis.";
            }
            setTimeout(() => {
                output.innerHTML = '<strong>Analysis:</strong> ' + answer;
            }, 300);
            input.value = '';
            return;
        }

        try {
            const resp = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    model: 'llama3',
                    messages: [
                        { role: 'system', content: 'You are a senior security engineer assistant. Answer concisely about finding: ' + title },
                        { role: 'user', content: question }
                    ]
                })
            });
            const data = await resp.json();
            output.innerHTML = '<strong>Analysis:</strong> ' + (data.message?.content || JSON.stringify(data));
        } catch(e) {
            output.innerHTML = '<strong>Analysis:</strong> ' + question + ' — Consult the detailed remediation guidance above.';
        }
        input.value = '';
    };

    document.addEventListener('DOMContentLoaded', () => {
        if (window.getStorage) {
            const saved = window.getStorage('phantomscan_llm_endpoint', '');
            if (saved) {
                const input = document.getElementById('llm-endpoint-input');
                if (input) input.value = saved;
            }
        }
    });
})();
</script>
