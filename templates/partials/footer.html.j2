<!-- Footer Section -->
<footer style="margin-top: 64px; padding: 48px 24px; border-top: 1px solid var(--border); background: var(--surface); text-align: center; color: var(--text-muted);">
    <div style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-bottom: 16px;">
        <div style="width: 20px; height: 20px; border-radius: 4px; background: linear-gradient(135deg, var(--accent), var(--accent2)); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 10px; color: white;">PS</div>
        <div style="font-weight: 800; letter-spacing: 0.05em; font-size: 14px;">
            PHANTOMSCAN
        </div>
    </div>
    
    <p style="font-size: 12px; max-width: 600px; margin: 0 auto 24px auto; line-height: 1.6;">
        This report contains confidential information intended only for the authorized recipient. 
        The findings represented here are a point-in-time snapshot of the target's security posture 
        and may not reflect current conditions.
    </p>
    
    <div style="font-size: 11px; display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
        <span>Generated: {{ scan.timestamp | format_date }}</span>
        <span>|</span>
        <span>Version: {{ report_version }}</span>
        <span>|</span>
        <span>Target: {{ scan.target }}</span>
    </div>

    {% if scan_metadata and (scan_metadata.circuit_breakers_opened or scan_metadata.degradation_active) %}
    <div style="max-width: 600px; margin: 16px auto 0 auto; background: rgba(245, 158, 11, 0.1); border: 1px solid var(--med); border-radius: 6px; padding: 10px 16px; font-size: 11px; color: var(--med); text-align: left;">
        <div style="font-weight: 700; margin-bottom: 4px;">⚠️ Degradation Notice & Service Status</div>
        {% if scan_metadata.circuit_breakers_opened %}
        <div>• <strong>Circuit Breakers Tripped:</strong> {{ scan_metadata.circuit_breakers_opened | join(', ') }} — Dependent enrichment sections were skipped or used cached data.</div>
        {% endif %}
        {% if scan_metadata.degradation_active %}
        {% for msg in scan_metadata.degradation_active %}
        <div>• {{ msg }}</div>
        {% endfor %}
        {% endif %}
    </div>
    {% endif %}
    <!-- v2.1 Local LLM Endpoint Config for Embedded Chat (Module 14) -->
    <div style="max-width: 500px; margin: 24px auto 0 auto; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 16px; font-size: 12px;">
        <div style="font-weight: 700; color: var(--text); margin-bottom: 8px;">⚙️ AI Assistant Settings (Module 14)</div>
        <div style="display: flex; gap: 8px;">
            <input type="text" id="llm-endpoint-input" placeholder="e.g. http://localhost:11434/api/chat (Ollama)" style="flex: 1; background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: 4px; padding: 6px 10px; font-size: 11px;" value="">
            <button class="btn btn-secondary" style="font-size: 11px;" onclick="saveLlmEndpoint()">Save Endpoint</button>
        </div>
        <div style="color: var(--text-muted); font-size: 10px; margin-top: 6px; text-align: left;">
            Configures local Ollama endpoint for interactive AI finding chat. If empty, falls back to static security FAQs.
        </div>
    </div>
</footer>

<script>
    function saveLlmEndpoint() {
        const val = document.getElementById('llm-endpoint-input').value.trim();
        setStorage('phantomscan_llm_endpoint', val);
        alert(val ? 'LLM Endpoint saved!' : 'Cleared LLM Endpoint (using static FAQs)');
    }
    
    document.addEventListener('DOMContentLoaded', () => {
        const saved = getStorage('phantomscan_llm_endpoint', '');
        if (saved) {
            const input = document.getElementById('llm-endpoint-input');
            if (input) input.value = saved;
        }
    });

    async function askFindingQuestion(index, findingId, title) {
        const input = document.getElementById('chat-input-' + index);
        const output = document.getElementById('chat-output-' + index);
        const question = input.value.trim();
        if (!question) return;

        output.innerHTML = '⏳ Thinking...';
        const endpoint = getStorage('phantomscan_llm_endpoint', '');

        if (!endpoint) {
            // Static FAQ Fallback
            let answer = "[Static FAQ] ";
            const q = question.lower ? question.lower() : question.toLowerCase();
            if (q.includes("why") || q.includes("severity")) {
                answer += "This finding was flagged because of security pattern match evidence in the endpoint response.";
            } else if (q.includes("fix") || q.includes("patch") || q.includes("remediat")) {
                answer += "Review the recommended patch steps above or consult OWASP/CWE references.";
            } else {
                answer += "Configure a local Ollama endpoint (e.g. http://localhost:11434/api/chat) in settings below for full AI explanations.";
            }
            output.innerHTML = '<strong>A:</strong> ' + answer;
            input.value = '';
            return;
        }

        try {
            const resp = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    model: 'llama3',
                    messages: [
                        { role: 'system', content: 'You are a security analyst assistant. Answer concisely about finding: ' + title },
                        { role: 'user', content: question }
                    ]
                })
            });
            const data = await resp.json();
            output.innerHTML = '<strong>A:</strong> ' + (data.message?.content || JSON.stringify(data));
        } catch(e) {
            output.innerHTML = '<strong>A:</strong> [Static FAQ Fallback] ' + question;
        }
        input.value = '';
    }
</script>
