<!-- Security Score Dashboard Section -->
<section id="score" class="section">
    <div class="section-label" style="margin-bottom: 20px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        <span style="color: var(--teal);">SECURITY SCORE &amp; METRICS</span>
    </div>

    <div class="grid-3">
        <!-- Main Score Card -->
        <div class="card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; position: relative; overflow: hidden; padding: 20px 14px;">
            <h3 style="color: var(--text-tertiary); margin-bottom: 6px; font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; font-family: 'Syne', sans-serif;">Overall Grade</h3>
            <div style="font-size: 72px; font-weight: 800; line-height: 1; color: {% if score.value >= 80 %}var(--sev-low){% elif score.value >= 60 %}var(--sev-medium){% else %}var(--sev-critical){% endif %}; font-family: 'Syne', sans-serif;">
                {{ score.grade | default('B') }}
            </div>
            <div style="font-size: 20px; font-weight: 700; margin-top: -4px; font-family: 'JetBrains Mono', monospace;">
                <span id="animated-score">{{ score.value | default(0) }}</span><span style="color: var(--text-tertiary);">/100</span>
                <span id="final-score-val" style="display: none;">{{ score.value | default(0) }}</span>
            </div>

            {% if score.trend != 'none' %}
            <div class="pill" style="margin-top: 8px; background: var(--surface); border-color: {% if score.trend == 'up' %}var(--sev-low-bd){% else %}var(--sev-critical-bd){% endif %}; color: {% if score.trend == 'up' %}var(--sev-low){% else %}var(--sev-critical){% endif %}; font-size: 10px;">
                {{ 'Improved' if score.trend == 'up' else 'Posture Baseline' }}
            </div>
            {% endif %}
        </div>

        <!-- Category Breakdown Radar Chart (Interactive Native SVG) -->
        <div class="card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 16px 14px; position: relative;">
            <h3 style="margin-bottom: 6px; font-size: 10px; font-weight: 700; color: var(--teal); text-transform: uppercase; letter-spacing: 0.06em; text-align: center; font-family: 'Syne', sans-serif;">
                Category Breakdown
            </h3>

            {% set s_web = 85 if score.value >= 80 else (75 if score.value >= 60 else 45) %}
            {% set s_net = 92 if intel.open_ports|length <= 3 else 70 %}
            {% set s_ssl = 95 if intel.ssl.grade in ['A+', 'A'] else (80 if intel.ssl.grade in ['B', 'C'] else 60) %}
            {% set s_email = (intel.email_security.score * 10) if intel.email_security.score else 70 %}
            {% set s_api = 85 %}
            {% set s_auth = 85 %}

            {% set p0_x = 150.0 %}
            {% set p0_y = 135.0 - (s_web / 100.0) * 80.0 %}
            {% set p1_x = 150.0 + (s_net / 100.0) * 80.0 * 0.866025 %}
            {% set p1_y = 135.0 - (s_net / 100.0) * 80.0 * 0.5 %}
            {% set p2_x = 150.0 + (s_ssl / 100.0) * 80.0 * 0.866025 %}
            {% set p2_y = 135.0 + (s_ssl / 100.0) * 80.0 * 0.5 %}
            {% set p3_x = 150.0 %}
            {% set p3_y = 135.0 + (s_email / 100.0) * 80.0 %}
            {% set p4_x = 150.0 - (s_api / 100.0) * 80.0 * 0.866025 %}
            {% set p4_y = 135.0 + (s_api / 100.0) * 80.0 * 0.5 %}
            {% set p5_x = 150.0 - (s_auth / 100.0) * 80.0 * 0.866025 %}
            {% set p5_y = 135.0 - (s_auth / 100.0) * 80.0 * 0.5 %}

            <div style="width: 100%; max-width: 280px; height: 220px; display: flex; align-items: center; justify-content: center; position: relative;" id="radar-wrapper">
                <div id="radar-tooltip" style="position: absolute; background: var(--card); border: 1px solid var(--teal); color: var(--text-primary); padding: 5px 10px; border-radius: var(--r-compact); font-size: 11px; font-family: 'JetBrains Mono', monospace; pointer-events: none; opacity: 0; transition: opacity 0.15s, transform 0.15s; transform: translate(-50%, -100%); margin-top: -10px; z-index: 30; box-shadow: var(--shadow-md); white-space: nowrap;"></div>
                <svg viewBox="0 0 300 270" style="width: 100%; height: 100%; overflow: visible;" id="category-radar-svg">
                    <polygon points="150,119 163.9,127 163.9,143 150,151 136.1,143 136.1,127" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1"></polygon>
                    <polygon points="150,103 177.7,119 177.7,151 150,167 122.3,151 122.3,119" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1"></polygon>
                    <polygon points="150,87 191.6,111 191.6,159 150,183 108.4,159 108.4,111" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1"></polygon>
                    <polygon points="150,71 205.4,103 205.4,167 150,199 94.6,167 94.6,103" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1"></polygon>
                    <polygon points="150,55 219.3,95 219.3,175 150,215 80.7,175 80.7,95" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1"></polygon>

                    <line x1="150" y1="135" x2="150" y2="55" stroke="rgba(255,255,255,0.1)" stroke-width="1"></line>
                    <line x1="150" y1="135" x2="219.3" y2="95" stroke="rgba(255,255,255,0.1)" stroke-width="1"></line>
                    <line x1="150" y1="135" x2="219.3" y2="175" stroke="rgba(255,255,255,0.1)" stroke-width="1"></line>
                    <line x1="150" y1="135" x2="150" y2="215" stroke="rgba(255,255,255,0.1)" stroke-width="1"></line>
                    <line x1="150" y1="135" x2="80.7" y2="175" stroke="rgba(255,255,255,0.1)" stroke-width="1"></line>
                    <line x1="150" y1="135" x2="80.7" y2="95" stroke="rgba(255,255,255,0.1)" stroke-width="1"></line>

                    <text x="150" y="52" fill="var(--text-tertiary)" font-size="9" text-anchor="middle" font-family="'JetBrains Mono', monospace">100</text>
                    <text x="150" y="68" fill="var(--text-tertiary)" font-size="9" text-anchor="middle" font-family="'JetBrains Mono', monospace">80</text>
                    <text x="150" y="84" fill="var(--text-tertiary)" font-size="9" text-anchor="middle" font-family="'JetBrains Mono', monospace">60</text>
                    <text x="150" y="100" fill="var(--text-tertiary)" font-size="9" text-anchor="middle" font-family="'JetBrains Mono', monospace">40</text>
                    <text x="150" y="116" fill="var(--text-tertiary)" font-size="9" text-anchor="middle" font-family="'JetBrains Mono', monospace">20</text>

                    <polygon id="radar-polygon"
                             points="{{ p0_x|round(1) }},{{ p0_y|round(1) }} {{ p1_x|round(1) }},{{ p1_y|round(1) }} {{ p2_x|round(1) }},{{ p2_y|round(1) }} {{ p3_x|round(1) }},{{ p3_y|round(1) }} {{ p4_x|round(1) }},{{ p4_y|round(1) }} {{ p5_x|round(1) }},{{ p5_y|round(1) }}"
                             fill="rgba(13, 148, 136, 0.2)"
                             stroke="#0d9488"
                             stroke-width="2"
                             stroke-linejoin="round"></polygon>

                    <!-- Interactive Vertex Groups -->
                    {% for idx, px, py, cat, sc in [(0, p0_x, p0_y, 'Web Security', s_web), (1, p1_x, p1_y, 'Network Security', s_net), (2, p2_x, p2_y, 'SSL / TLS Security', s_ssl), (3, p3_x, p3_y, 'Email Security', s_email), (4, p4_x, p4_y, 'API Security', s_api), (5, p5_x, p5_y, 'Authentication', s_auth)] %}
                    <g class="radar-vertex" data-index="{{ idx }}" data-cat="{{ cat }}" data-score="{{ sc }}">
                        <title>{{ cat }}: {{ sc }} / 100 pts</title>
                        <circle id="hit-{{ idx }}" cx="{{ px|round(1) }}" cy="{{ py|round(1) }}" r="18" fill="rgba(0,0,0,0.001)" pointer-events="all" style="cursor: pointer;"></circle>
                        <circle id="dot-{{ idx }}" cx="{{ px|round(1) }}" cy="{{ py|round(1) }}" r="3.5" fill="#ffffff" stroke="#0d9488" stroke-width="2" style="transition: all 0.15s; pointer-events: none;"></circle>
                    </g>
                    {% endfor %}

                    <!-- Interactive Labels -->
                    <text id="label-0" class="radar-label" data-index="0" x="150" y="38" fill="var(--text-primary)" font-size="12" font-weight="700" text-anchor="middle" font-family="'Inter', sans-serif" style="cursor: pointer;">Web</text>
                    <text id="label-1" class="radar-label" data-index="1" x="228" y="93" fill="var(--text-primary)" font-size="12" font-weight="700" text-anchor="start" font-family="'Inter', sans-serif" style="cursor: pointer;">Network</text>
                    <text id="label-2" class="radar-label" data-index="2" x="228" y="182" fill="var(--text-primary)" font-size="12" font-weight="700" text-anchor="start" font-family="'Inter', sans-serif" style="cursor: pointer;">SSL</text>
                    <text id="label-3" class="radar-label" data-index="3" x="150" y="235" fill="var(--text-primary)" font-size="12" font-weight="700" text-anchor="middle" font-family="'Inter', sans-serif" style="cursor: pointer;">Email</text>
                    <text id="label-4" class="radar-label" data-index="4" x="72" y="182" fill="var(--text-primary)" font-size="12" font-weight="700" text-anchor="end" font-family="'Inter', sans-serif" style="cursor: pointer;">API</text>
                    <text id="label-5" class="radar-label" data-index="5" x="72" y="93" fill="var(--text-primary)" font-size="12" font-weight="700" text-anchor="end" font-family="'Inter', sans-serif" style="cursor: pointer;">Auth</text>
                </svg>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="card" style="display: flex; flex-direction: column; justify-content: center; gap: 10px; padding: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid var(--border);">
                <span style="color: var(--text-secondary); font-size: 12px; font-weight: 500;">Critical Findings</span>
                <span class="pill badge-critical" style="min-width: 24px; text-align: center;">{{ findings | selectattr('severity', 'equalto', 'critical') | list | length }}</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid var(--border);">
                <span style="color: var(--text-secondary); font-size: 12px; font-weight: 500;">High Findings</span>
                <span class="pill badge-high" style="min-width: 24px; text-align: center;">{{ findings | selectattr('severity', 'equalto', 'high') | list | length }}</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid var(--border);">
                <span style="color: var(--text-secondary); font-size: 12px; font-weight: 500;">Medium Findings</span>
                <span class="pill badge-medium" style="min-width: 24px; text-align: center;">{{ findings | selectattr('severity', 'equalto', 'medium') | list | length }}</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 8px; border-bottom: 1px solid var(--border);">
                <span style="color: var(--text-secondary); font-size: 12px; font-weight: 500;">Low/Info Findings</span>
                <span class="pill badge-low" style="min-width: 24px; text-align: center;">{{ (findings | selectattr('severity', 'equalto', 'low') | list | length) + (findings | selectattr('severity', 'equalto', 'info') | list | length) }}</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <a href="#suppressed" style="color: var(--brand-light); text-decoration: none; font-size: 12px; font-weight: 600;">Suppressed False Positives</a>
                <span class="pill" style="background: var(--brand-glow) !important; color: var(--brand-light) !important; border-color: var(--brand) !important; font-weight: 700; min-width: 24px; text-align: center;">
                    {{ fp_log | length }}
                </span>
            </div>
        </div>
    </div>
</section>

<!-- Dynamic Radar Data Synchronizer & Interactivity -->
<script>
(function() {
    const catNames = ["Web Security", "Network Security", "SSL / TLS", "Email Security", "API Security", "Authentication"];
    const defaultScores = [{{ s_web }}, {{ s_net }}, {{ s_ssl }}, {{ s_email }}, {{ s_api }}, {{ s_auth }}];
    const radarWrapper = document.getElementById('radar-wrapper');
    const radarTooltip = document.getElementById('radar-tooltip');
    const radarSvg = document.getElementById('category-radar-svg');
    let activeVertex = -1;

    function getRadarScores() {
        if (window.state && window.state.chartData && window.state.chartData.category_radar && window.state.chartData.category_radar.data) {
            return window.state.chartData.category_radar.data;
        }
        return defaultScores;
    }

    function highlightVertex(index, e) {
        if (activeVertex === index) return;
        unhighlightAll();
        activeVertex = index;

        const scores = getRadarScores();
        const score = scores[index] !== undefined ? scores[index] : defaultScores[index];
        const cat = catNames[index] || 'Category';

        const dot = document.getElementById('dot-' + index);
        if (dot) {
            dot.setAttribute('r', '6.5');
            dot.setAttribute('fill', '#2dd4bf');
            dot.setAttribute('stroke', '#ffffff');
            dot.setAttribute('stroke-width', '2.5');
        }

        if (radarTooltip && radarWrapper && radarSvg) {
            radarTooltip.innerHTML = `<strong>${cat}</strong>: <span style="color:#0d9488;font-weight:700;">${score}</span> / 100 pts`;
            radarTooltip.style.opacity = '1';

            if (dot) {
                const cx = parseFloat(dot.getAttribute('cx'));
                const cy = parseFloat(dot.getAttribute('cy'));
                const svgRect = radarSvg.getBoundingClientRect();
                const wrapRect = radarWrapper.getBoundingClientRect();
                const scaleX = svgRect.width / 300;
                const scaleY = svgRect.height / 270;
                const posX = (svgRect.left - wrapRect.left) + cx * scaleX;
                const posY = (svgRect.top - wrapRect.top) + cy * scaleY;
                radarTooltip.style.left = posX + 'px';
                radarTooltip.style.top = posY + 'px';
            }
        }
    }

    function unhighlightAll() {
        activeVertex = -1;
        for (let i = 0; i < 6; i++) {
            const dot = document.getElementById('dot-' + i);
            if (dot) {
                dot.setAttribute('r', '3.5');
                dot.setAttribute('fill', '#ffffff');
                dot.setAttribute('stroke', '#0d9488');
                dot.setAttribute('stroke-width', '2');
            }
        }
        if (radarTooltip) {
            radarTooltip.style.opacity = '0';
        }
    }

    if (radarSvg) {
        radarSvg.addEventListener('mousemove', (e) => {
            const svgRect = radarSvg.getBoundingClientRect();
            const mouseSvgX = ((e.clientX - svgRect.left) / svgRect.width) * 300;
            const mouseSvgY = ((e.clientY - svgRect.top) / svgRect.height) * 270;

            let closestIdx = -1;
            let minDist = 35;

            for (let i = 0; i < 6; i++) {
                const dot = document.getElementById('dot-' + i);
                if (dot) {
                    const dx = parseFloat(dot.getAttribute('cx')) - mouseSvgX;
                    const dy = parseFloat(dot.getAttribute('cy')) - mouseSvgY;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    if (dist < minDist) {
                        minDist = dist;
                        closestIdx = i;
                    }
                }
            }

            if (closestIdx !== -1) {
                highlightVertex(closestIdx, e);
            } else if (activeVertex !== -1) {
                unhighlightAll();
            }
        });

        radarSvg.addEventListener('mouseleave', unhighlightAll);
    }

    for (let i = 0; i < 6; i++) {
        const label = document.getElementById('label-' + i);
        if (label) {
            label.addEventListener('mouseenter', (e) => highlightVertex(i, e));
            label.addEventListener('mouseleave', unhighlightAll);
        }
    }

    function updateRadarFromData() {
        const scores = getRadarScores();
        if (!scores || scores.length < 6) return;

        const cx = 150, cy = 135, R = 80;
        const angles = [-90, -30, 30, 90, 150, 210];
        const pts = [];

        for (let i = 0; i < 6; i++) {
            const score = Math.max(5, Math.min(100, scores[i] || 100));
            const rad = angles[i] * Math.PI / 180;
            const r = (score / 100.0) * R;
            const x = Math.round((cx + r * Math.cos(rad)) * 10) / 10;
            const y = Math.round((cy + r * Math.sin(rad)) * 10) / 10;
            pts.push(`${x},${y}`);

            const dot = document.getElementById(`dot-${i}`);
            const hit = document.getElementById(`hit-${i}`);
            if (dot) { dot.setAttribute('cx', x); dot.setAttribute('cy', y); }
            if (hit) { hit.setAttribute('cx', x); hit.setAttribute('cy', y); }
        }

        const poly = document.getElementById('radar-polygon');
        if (poly && pts.length === 6) {
            poly.setAttribute('points', pts.join(' '));
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateRadarFromData);
    } else {
        updateRadarFromData();
    }
})();
</script>
