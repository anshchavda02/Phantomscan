<!-- Target Intelligence Panel -->
<style>
    .intel-section {
        background: linear-gradient(180deg, rgba(13,148,136,0.04) 0%, transparent 100%);
        border-top: 1px solid rgba(13,148,136,0.15);
        border-bottom: 1px solid var(--border);
        padding: var(--sp-2xl) 0; margin-bottom: var(--sp-3xl);
    }
    .intel-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-md); }
    @media (max-width: 1200px) { .intel-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 768px) { .intel-grid { grid-template-columns: 1fr; } }
    .intel-card {
        background: var(--card); border: 1px solid var(--border);
        border-radius: var(--r-standard); padding: 0; overflow: hidden;
        transition: border-color 0.15s;
    }
    .intel-card:hover { border-color: var(--border-light); }
    .intel-card-header {
        display: flex; align-items: center; gap: 6px; padding: 12px 14px;
        font-weight: 700; font-size: 11px; cursor: pointer; user-select: none;
        text-transform: uppercase; letter-spacing: 0.06em;
    }
    .intel-card-header .count-pill { margin-left: auto; }
    .intel-card-content {
        padding: 0 14px 14px; display: flex; flex-direction: column; gap: 4px;
        transition: max-height 0.25s ease, opacity 0.2s ease;
    }
</style>

<section id="intel" class="intel-section">
    <div class="container">
        <!-- Section Title Bar -->
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 8px;">
            <div class="section-label" style="margin-bottom: 0;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/></svg>
                <span style="color: var(--teal);">TARGET INTELLIGENCE</span>
            </div>
            <div style="font-size: 11px; color: var(--text-tertiary); font-style: italic;">
                {% if intel.ip_info %}Hosted on {{ intel.ip_info[0].hosting or 'Cloud' }}{% endif %}
                &middot; {{ intel.ip_info | length }} IP address{{ 'es' if intel.ip_info | length != 1 else '' }}
                &middot; {{ intel.subdomains | length }} subdomain{{ 's' if intel.subdomains | length != 1 else '' }}
                &middot; SSL {{ intel.ssl.grade if intel.ssl.grade else 'N/A' }}
            </div>
        </div>

        <div class="intel-grid">
            {% include 'partials/whois.html.j2' ignore missing %}
            {% include 'partials/dns.html.j2' ignore missing %}
            {% include 'partials/subdomains.html.j2' ignore missing %}
            {% include 'partials/ip_intel.html.j2' ignore missing %}
            {% include 'partials/ssl.html.j2' ignore missing %}
            {% include 'partials/tech_stack.html.j2' ignore missing %}
            {% include 'partials/email_security.html.j2' ignore missing %}
            {% include 'partials/ports.html.j2' ignore missing %}
        </div>

        {% include 'partials/attack_map.html.j2' ignore missing %}
    </div>
</section>
