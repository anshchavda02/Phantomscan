<!-- Sticky Navigation Bar -->
<div class="top-nav" style="position: sticky; top: 0; z-index: 50; height: 52px; background: var(--nav-bg); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 24px; transition: background 0.2s ease;">
    <div style="display: flex; align-items: center; gap: 8px;">
        <div style="font-weight: 800; letter-spacing: 0.05em; font-size: 16px;">
            <span style="color: var(--accent-light);">PHANTOM</span><span style="color: var(--text);">SCAN</span>
        </div>
    </div>
    
    <div style="display: none;" class="desktop-nav">
        <!-- Add pill tabs here for desktop -->
    </div>
    
    <div style="display: flex; align-items: center; gap: 12px;">
        <div class="pill" style="background: var(--surface); color: {% if score.value >= 80 %}var(--low){% elif score.value >= 60 %}var(--med){% else %}var(--crit){% endif %}; border-color: currentColor;">
            Score: {{ score.value }}/100 ({{ score.grade }})
        </div>
        <button id="theme-toggle" title="Toggle Dark/Light Mode">🌓</button>
        <button onclick="window.print()" title="Print Report">🖨️</button>
        <button onclick="window.exportJSON()" title="Export JSON">📊</button>
    </div>
</div>

<!-- Floating Right Sidebar (Desktop only) -->
<style>
    @media (min-width: 1200px) {
        .desktop-nav { display: flex !important; gap: 8px; }
        .sidebar { position: fixed; right: 20px; top: 50%; transform: translateY(-50%); z-index: 40; display: flex; flex-direction: column; gap: 12px; }
        .sidebar-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--surface); border: 1px solid var(--border); cursor: pointer; transition: all 0.2s; position: relative; }
        .sidebar-dot:hover, .sidebar-dot.active { background: var(--accent2); border-color: var(--accent2); box-shadow: 0 0 10px var(--accent2-glow); }
        .sidebar-dot::after { content: attr(title); position: absolute; right: 16px; top: 50%; transform: translateY(-50%); background: var(--surface); color: var(--text); padding: 4px 8px; border-radius: 4px; font-size: 11px; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 0.2s; border: 1px solid var(--border); }
        .sidebar-dot:hover::after { opacity: 1; }
    }
    @media (max-width: 1199px) {
        .sidebar { display: none; }
    }
</style>

<div class="sidebar">
    <a href="#header" class="sidebar-dot" title="Header" data-target="header"></a>
    <a href="#intel" class="sidebar-dot" title="Target Intelligence" data-target="intel"></a>
    <a href="#summary" class="sidebar-dot" title="Executive Summary" data-target="summary"></a>
    <a href="#score" class="sidebar-dot" title="Security Score" data-target="score"></a>
    <a href="#findings" class="sidebar-dot" title="All Findings" data-target="findings"></a>
    <a href="#privacy" class="sidebar-dot" title="Privacy & PII" data-target="privacy"></a>
    <a href="#expiry-calendar" class="sidebar-dot" title="Expiry Calendar" data-target="expiry-calendar"></a>
</div>
