<!-- Sticky Navigation Bar -->
<div class="top-nav" style="position: sticky; top: 0; z-index: 50; height: 48px; background: var(--nav-bg); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 24px;">
    <div style="display: flex; align-items: center; gap: 6px;">
        <div style="width: 22px; height: 22px; border-radius: 3px; background: var(--accent); display: flex; align-items: center; justify-content: center;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <span style="font-family: 'Syne', sans-serif; font-weight: 800; font-size: 14px; letter-spacing: 0.04em;">PHANTOM<span style="color: var(--accent-light);">SCAN</span></span>
    </div>
    
    <div style="display: none;" class="desktop-nav">
        <a href="#summary" class="pill" style="text-decoration: none;">Summary</a>
        <a href="#score" class="pill" style="text-decoration: none;">Score</a>
        <a href="#findings" class="pill" style="text-decoration: none;">Findings ({{ findings|length }})</a>
        <a href="#suppressed" class="pill" style="text-decoration: none; border-color: var(--accent-glow); color: var(--accent-light);">Suppressed ({{ fp_log|length }})</a>
    </div>
    
    <div style="display: flex; align-items: center; gap: 8px;">
        <div class="pill" style="background: {% if score.value >= 80 %}var(--low-bg){% elif score.value >= 60 %}var(--med-bg){% else %}var(--crit-bg){% endif %}; color: {% if score.value >= 80 %}var(--low){% elif score.value >= 60 %}var(--med){% else %}var(--crit){% endif %}; border-color: {% if score.value >= 80 %}var(--low-border){% elif score.value >= 60 %}var(--med-border){% else %}var(--crit-border){% endif %}; font-weight: 700; font-family: 'JetBrains Mono', monospace; font-size: 11px;">
            {{ score.value }}/100 &middot; {{ score.grade }}
        </div>
        <button id="theme-toggle" onclick="window.toggleTheme()" title="Toggle Theme" style="padding: 4px 8px; font-size: 13px;">&#9681;</button>
        <button onclick="window.printReport()" title="Print / PDF Report" style="padding: 4px 10px; font-size: 11px; font-weight: 600;">PDF</button>
        <button onclick="window.exportJSON()" title="Export JSON" style="padding: 4px 10px; font-size: 11px;">JSON</button>
    </div>
</div>

<!-- Sidebar -->
<style>
    @media (min-width: 1200px) {
        .desktop-nav { display: flex !important; gap: 6px; }
        .sidebar { position: fixed; right: 16px; top: 50%; transform: translateY(-50%); z-index: 40; display: flex; flex-direction: column; gap: 10px; }
        .sidebar-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--border-light); cursor: pointer; transition: all 0.2s; position: relative; }
        .sidebar-dot:hover, .sidebar-dot.active { background: var(--accent); box-shadow: 0 0 8px var(--accent-glow); }
        .sidebar-dot::after { content: attr(title); position: absolute; right: 14px; top: 50%; transform: translateY(-50%); background: var(--card); color: var(--text-muted); padding: 3px 8px; border-radius: 3px; font-size: 10px; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity 0.15s; border: 1px solid var(--border); }
        .sidebar-dot:hover::after { opacity: 1; }
    }
    @media (max-width: 1199px) { .sidebar { display: none; } }
</style>
<div class="sidebar">
    <a href="#header" class="sidebar-dot" title="Header"></a>
    <a href="#intel" class="sidebar-dot" title="Target Intelligence"></a>
    <a href="#summary" class="sidebar-dot" title="Executive Summary"></a>
    <a href="#score" class="sidebar-dot" title="Security Score"></a>
    <a href="#findings" class="sidebar-dot" title="Findings"></a>
    <a href="#privacy" class="sidebar-dot" title="Privacy"></a>
    <a href="#expiry-calendar" class="sidebar-dot" title="Expiry Calendar"></a>
    <a href="#suppressed" class="sidebar-dot" title="Suppressed"></a>
</div>
