<!-- Technology Stack Panel -->
<div class="intel-card" style="border-left: 3px solid var(--mod-web);">
    <div class="intel-card-header" style="color: var(--mod-web);" onclick="this.nextElementSibling.classList.toggle('hidden')">
        <span>⚡ TECHNOLOGY STACK</span>
        <span style="margin-left: auto;" class="pill">{{ intel.tech_stack|length }} detected</span>
    </div>
    <div class="intel-card-content">
        {% if intel.tech_stack %}
            <div style="display: flex; flex-wrap: wrap; gap: 6px; max-height: 180px; overflow-y: auto;">
                {% for tech in intel.tech_stack %}
                <div class="pill" style="padding: 4px 8px; border-radius: 4px; border-left: 2px solid {% if tech.cves > 0 %}var(--crit){% else %}var(--border-glow){% endif %}; display: flex; align-items: center; gap: 6px;">
                    <span style="font-weight: 600;">{{ tech.name }}</span>
                    {% if tech.version %}
                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: {% if tech.cves > 0 %}var(--crit){% else %}var(--text-muted){% endif %};">{{ tech.version }}</span>
                    {% endif %}
                    {% if tech.cves > 0 %}
                    <span style="font-size: 10px; background: var(--crit); color: white; padding: 2px 4px; border-radius: 4px;">{{ tech.cves }} CVEs</span>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center" style="color: var(--text-muted); font-size: 12px; padding: 12px 0;">
                No technologies identified
            </div>
        {% endif %}
    </div>
</div>
