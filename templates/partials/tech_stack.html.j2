<!-- Technology Stack Panel -->
<div class="intel-card" style="border-left: 2px solid var(--mod-web);">
    <div class="intel-card-header" style="color: var(--mod-web);" onclick="window.toggleCollapsible(this)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        <span>TECHNOLOGY STACK</span>
        <span style="margin-left: auto;" class="pill">{{ intel.tech_stack|length }} detected</span>
    </div>
    <div class="intel-card-content">
        {% if intel.tech_stack %}
            <div style="display: flex; flex-wrap: wrap; gap: 5px; max-height: 180px; overflow-y: auto;">
                {% for tech in intel.tech_stack %}
                <div class="pill" style="padding: 3px 6px; border-radius: 3px; border-left: 2px solid {% if tech.cves > 0 %}var(--crit){% else %}var(--border-glow){% endif %}; display: flex; align-items: center; gap: 5px;">
                    <span style="font-weight: 600; color: var(--text);">{{ tech.name }}</span>
                    {% if tech.version %}
                    <span style="font-family: 'JetBrains Mono', monospace; font-size: 10px; color: {% if tech.cves > 0 %}var(--crit){% else %}var(--text-muted){% endif %};">{{ tech.version }}</span>
                    {% endif %}
                    {% if tech.cves > 0 %}
                    <span style="font-size: 9px; background: var(--crit); color: white; padding: 1px 4px; border-radius: 2px;">{{ tech.cves }} CVEs</span>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center" style="color: var(--text-dim); font-size: 11px; padding: 8px 0;">
                No technologies identified
            </div>
        {% endif %}
    </div>
</div>
