<!-- Unified Expiry Calendar Section -->
<section id="expiry-calendar" class="section">
    <div class="section-label">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span style="color: var(--teal);">UNIFIED EXPIRY CALENDAR</span>
        <span class="pill" style="font-size: 10px; background: var(--teal-dim); color: var(--teal-light); border-color: rgba(13,148,136,0.3); margin-left: auto;">Domain &amp; SSL Timelines</span>
    </div>

    <div class="card">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px;">
            {% if intel and intel.whois and intel.whois.expiry_date %}
            <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-compact); padding: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <span style="font-size: 12px; font-weight: 600;">Domain Expiry</span>
                    {% if intel.whois.days_remaining <= 30 %}
                        <span class="pill badge-critical">CRITICAL ({{ intel.whois.days_remaining }}d)</span>
                    {% elif intel.whois.days_remaining <= 90 %}
                        <span class="pill badge-medium">WARNING ({{ intel.whois.days_remaining }}d)</span>
                    {% else %}
                        <span class="pill badge-low">OK ({{ intel.whois.days_remaining }}d)</span>
                    {% endif %}
                </div>
                <div style="font-size: 12px; color: var(--text-secondary); line-height: 1.6;">
                    <strong>Target:</strong> {{ scan.target }}<br>
                    <strong>Expiry Date:</strong> {{ intel.whois.expiry_date }}<br>
                    <strong>Registrar:</strong> {{ intel.whois.registrar or 'N/A' }}
                </div>
            </div>
            {% endif %}

            {% if intel and intel.ssl and intel.ssl.expiry_days %}
            <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-compact); padding: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <span style="font-size: 12px; font-weight: 600;">Primary SSL Expiry</span>
                    {% if intel.ssl.expiry_days <= 30 %}
                        <span class="pill badge-critical">EXPIRES SOON ({{ intel.ssl.expiry_days }}d)</span>
                    {% elif intel.ssl.expiry_days <= 90 %}
                        <span class="pill badge-medium">WARNING ({{ intel.ssl.expiry_days }}d)</span>
                    {% else %}
                        <span class="pill badge-low">VALID ({{ intel.ssl.expiry_days }}d)</span>
                    {% endif %}
                </div>
                <div style="font-size: 12px; color: var(--text-secondary); line-height: 1.6;">
                    <strong>Common Name:</strong> {{ intel.ssl.common_name or scan.target }}<br>
                    <strong>Issuer:</strong> {{ intel.ssl.issuer or 'N/A' }}<br>
                    <strong>SSL Grade:</strong> <strong style="color: var(--sev-medium);">{{ intel.ssl.grade or 'A+' }}</strong>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</section>
