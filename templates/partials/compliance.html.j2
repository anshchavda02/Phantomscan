<!-- Compliance Section -->
{% if compliance and compliance.frameworks %}
<section id="compliance" class="section">
    <div class="section-label">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span style="color: #818cf8;">COMPLIANCE BENCHMARKS</span>
    </div>

    <div class="grid-3">
        {% for results in compliance.frameworks %}
        <div class="card" style="display: flex; flex-direction: column; gap: 12px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h3 style="margin: 0; font-size: 13px; font-family: 'Syne', sans-serif;">{{ results.name | upper }}</h3>
                {% set total = results.passed + results.failed %}
                {% set pass_rate = ((results.passed / total) * 100) | round(0) if total > 0 else 100 %}

                <div class="pill" style="font-size: 10px; border-color: {% if pass_rate == 100 %}var(--sev-low-bd){% elif pass_rate >= 80 %}var(--sev-medium-bd){% else %}var(--sev-critical-bd){% endif %}; color: {% if pass_rate == 100 %}var(--sev-low){% elif pass_rate >= 80 %}var(--sev-medium){% else %}var(--sev-critical){% endif %}; font-weight: 700;">
                    {{ pass_rate }}% Pass
                </div>
            </div>

            <div style="display: flex; gap: 8px; margin-top: 4px;">
                <div style="flex: 1; text-align: center; background: var(--surface); padding: 8px; border-radius: var(--r-compact); border: 1px solid var(--border);">
                    <div style="font-size: 20px; font-weight: 700; color: var(--sev-low); font-family: 'JetBrains Mono', monospace;">{{ results.passed }}</div>
                    <div style="font-size: 9px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.05em;">Passed</div>
                </div>
                <div style="flex: 1; text-align: center; background: var(--surface); padding: 8px; border-radius: var(--r-compact); border: 1px solid var(--border);">
                    <div style="font-size: 20px; font-weight: 700; color: var(--sev-critical); font-family: 'JetBrains Mono', monospace;">{{ results.failed }}</div>
                    <div style="font-size: 9px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.05em;">Failed</div>
                </div>
            </div>

            {% if results.failing_controls %}
            <div style="margin-top: 4px;">
                <h4 style="font-size: 9px; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; font-family: 'Syne', sans-serif;">Failing Controls</h4>
                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                    {% for control in results.failing_controls %}
                    <span class="pill" style="font-size: 9px; font-family: 'JetBrains Mono', monospace; background: var(--sev-critical-bg); color: var(--sev-critical); border-color: var(--sev-critical-bd);">{{ control }}</span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</section>
{% endif %}
