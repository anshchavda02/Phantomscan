<!-- Hero Header Section -->
<style>
    .hero-section {
        min-height: 280px;
        position: relative;
        overflow: hidden;
        background: radial-gradient(ellipse at 20% 50%, rgba(124,58,237,0.15) 0%, transparent 60%),
                    radial-gradient(ellipse at 80% 20%, rgba(6,182,212,0.1) 0%, transparent 60%),
                    linear-gradient(180deg, #0a0a18 0%, #070710 100%);
        border-bottom: 1px solid var(--border);
        display: flex;
        flex-direction: column;
    }
    
    .light-mode .hero-section {
        background: radial-gradient(ellipse at 20% 50%, rgba(124,58,237,0.05) 0%, transparent 60%),
                    radial-gradient(ellipse at 80% 20%, rgba(6,182,212,0.05) 0%, transparent 60%),
                    linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    }

    .hero-grid {
        position: absolute;
        inset: 0;
        background-image: 
            linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 30px 30px;
        z-index: 1;
        pointer-events: none;
    }

    .scanline {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, transparent, rgba(6, 182, 212, 0.1) 50%, transparent);
        height: 100%;
        animation: scanline 8s linear infinite;
        z-index: 2;
        pointer-events: none;
    }

    .hero-content {
        position: relative;
        z-index: 10;
        flex: 1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
        padding: 48px 24px;
        max-width: 1400px;
        margin: 0 auto;
        width: 100%;
        align-items: center;
    }

    @media (max-width: 768px) {
        .hero-content { grid-template-columns: 1fr; }
    }

    .hero-title-group {
        display: flex;
        flex-direction: column;
    }

    .hero-title {
        font-size: 48px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.03em;
        margin-bottom: 8px;
    }

    .hero-tagline {
        font-size: 14px;
        color: var(--text-muted);
        font-style: italic;
        margin-bottom: 24px;
    }

    .hero-info-card {
        background: rgba(12, 12, 26, 0.6);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
    }
    
    .light-mode .hero-info-card {
        background: rgba(255, 255, 255, 0.6);
    }

    .target-url {
        font-size: 20px;
        font-weight: 700;
        word-break: break-all;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .meta-strip {
        border-top: 1px solid var(--border);
        background: rgba(7, 7, 16, 0.5);
        padding: 12px 24px;
        display: flex;
        justify-content: center;
        gap: 24px;
        font-size: 12px;
        color: var(--text-muted);
        position: relative;
        z-index: 10;
    }

    .module-strip {
        padding: 8px 24px;
        display: flex;
        gap: 8px;
        overflow-x: auto;
        white-space: nowrap;
        background: rgba(0,0,0,0.2);
        border-top: 1px solid var(--border);
        position: relative;
        z-index: 10;
    }
    
    .module-strip::-webkit-scrollbar {
        height: 4px;
    }
</style>

<section id="header" class="hero-section section visible">
    <div class="hero-grid"></div>
    <div class="scanline"></div>

    <div class="hero-content">
        <div class="hero-title-group fade-in-up">
            <div class="hero-title">
                <span style="color: var(--text);">PHANTOM</span><span style="color: var(--accent-light);">SCAN</span>
            </div>
            <div class="hero-tagline">Scan Smart. Stay Secure.</div>
            <div style="display: flex; gap: 8px;">
                <span class="pill" style="background: rgba(124,58,237,0.1); border-color: rgba(124,58,237,0.3); color: var(--accent-light);">v{{ report_version }}</span>
                <button onclick="document.getElementById('modules-modal').style.display='flex'" class="pill" style="cursor: pointer; background: rgba(6, 182, 212, 0.12); border-color: var(--accent); color: var(--accent-light); font-weight: 600; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s ease;" title="Click to view all executed modules">
                    <span>⚙️ {{ scan.modules_executed | length }} modules executed</span>
                    <span style="font-size: 10px; opacity: 0.8; font-weight: 400;">(View)</span>
                </button>
            </div>
        </div>

        <div class="hero-info-card fade-in-up" style="animation-delay: 0.1s;">
            <div class="target-url">
                {{ scan.target }}
                <button class="copy-btn" data-copy="{{ scan.target }}" style="padding: 4px; background: transparent; border: none; font-size: 16px;" title="Copy Target URL">📋</button>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase;">Scan Type</div>
                    <div style="font-weight: 600;">
                        <span class="pill" style="background: var(--info-bg); color: var(--info); border-color: var(--info-border); margin-top: 4px;">{{ scan.profile | upper }} SCAN</span>
                    </div>
                </div>
                <div>
                    <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase;">Duration</div>
                    <div style="font-weight: 600; margin-top: 4px;">{{ scan.duration_seconds | round(1) }}s</div>
                </div>
            </div>
            
            <div style="font-size: 11px; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 12px;">
                Started: {{ scan.timestamp | format_date }} &nbsp;|&nbsp; ID: <code>{{ scan.scan_id }}</code>
            </div>
        </div>
    </div>

    {% if engagement.client %}
    <div class="meta-strip">
        <span><strong>Client:</strong> {{ engagement.client }}</span>
        <span><strong>Assessor:</strong> {{ engagement.assessor }}</span>
        <span><strong>Type:</strong> {{ engagement.engagement_type }}</span>
        <span><strong>Ref:</strong> {{ engagement.reference }}</span>
    </div>
    <div style="background: #dc2626; color: white; text-align: center; font-weight: 700; padding: 6px; font-size: 12px; position: relative; z-index: 10;">
        ⚠ CONFIDENTIAL — AUTHORIZED SECURITY ASSESSMENT
    </div>
    {% endif %}
</section>

<!-- Executed Modules Modal -->
<div id="modules-modal" style="display: none; position: fixed; inset: 0; z-index: 1000; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(12px); align-items: center; justify-content: center; padding: 24px;" onclick="if(event.target===this) this.style.display='none';">
    <div style="background: #0d0d1f; border: 1px solid var(--border-light, #1e1e3f); border-radius: 16px; width: 100%; max-width: 760px; max-height: 80vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,0.8); overflow: hidden; animation: fadeIn 0.2s ease;">
        <!-- Modal Header -->
        <div style="padding: 20px 24px; border-bottom: 1px solid var(--border, #1e1e3f); display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.02);">
            <div style="display: flex; align-items: center; gap: 12px;">
                <span style="font-size: 22px;">⚙️</span>
                <div>
                    <h3 style="margin: 0; font-size: 18px; color: var(--text);">Executed Scanner Modules</h3>
                    <div style="font-size: 12px; color: var(--text-muted);">Total {{ scan.modules_executed | length }} security modules executed in this scan profile</div>
                </div>
            </div>
            <button onclick="document.getElementById('modules-modal').style.display='none'" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border); color: var(--text-muted); border-radius: 8px; width: 32px; height: 32px; cursor: pointer; font-size: 16px; display: flex; align-items: center; justify-content: center;" title="Close Modal">✕</button>
        </div>
        
        <!-- Modal Body (Grid of Modules) -->
        <div style="padding: 24px; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; max-height: 60vh;">
            {% for mod in scan.modules_executed %}
            <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 16px;">
                        {% if mod.status == 'completed' %}✅{% elif mod.status == 'failed' %}❌{% else %}⚠️{% endif %}
                    </span>
                    <div>
                        <div style="font-weight: 600; font-size: 13px; color: var(--text);">{{ mod.name }}</div>
                        <div style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Engine: {{ mod.engine | default('Python') }}</div>
                    </div>
                </div>
                <div style="text-align: right;">
                    <span class="pill" style="font-size: 10px; background: rgba(6, 182, 212, 0.1); color: var(--accent-light); border-color: rgba(6, 182, 212, 0.2);">{{ mod.duration | default(0.5) | round(1) }}s</span>
                </div>
            </div>
            {% endfor %}
        </div>

        <!-- Modal Footer -->
        <div style="padding: 16px 24px; border-top: 1px solid var(--border, #1e1e3f); text-align: right; background: rgba(0,0,0,0.3);">
            <button onclick="document.getElementById('modules-modal').style.display='none'" class="pill" style="cursor: pointer; background: var(--accent); color: white; border: none; padding: 8px 20px; font-weight: 600;">Close</button>
        </div>
    </div>
</div>
