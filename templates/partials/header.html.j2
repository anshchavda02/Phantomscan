<!-- Hero Header Section -->
<section id="header" class="section" style="background: linear-gradient(180deg, #080b18 0%, var(--bg) 100%); border-bottom: 1px solid var(--border); padding: 0; margin-bottom: 0;">
    <div style="max-width: 1320px; margin: 0 auto; padding: 40px 24px 36px; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                <span class="pill" style="font-size: 10px; background: var(--accent-glow); border-color: var(--accent); color: var(--accent-light);">v{{ report_version }}</span>
                <button onclick="document.getElementById('modules-modal').style.display='flex'" class="pill" style="font-size: 10px; cursor: pointer; background: var(--accent2-glow); border-color: var(--accent2); color: var(--accent2); font-weight: 600;" title="View all modules">
                    {{ scan.modules_executed | length }} MODULES EXECUTED
                </button>
            </div>
            <h1 style="font-size: 36px; font-weight: 800; line-height: 1.05; letter-spacing: -0.025em; margin-bottom: 6px;">
                Security<br>Assessment Report
            </h1>
            <p style="color: var(--text-dim); font-size: 12px; font-style: italic;">Automated Deep Scan &middot; Point-in-Time Analysis</p>
        </div>

        <div style="background: var(--card); border: 1px solid var(--border-light); border-radius: 6px; padding: 20px;">
            <div style="font-size: 17px; font-weight: 700; word-break: break-all; margin-bottom: 14px; display: flex; align-items: center; justify-content: space-between; gap: 8px; font-family: 'JetBrains Mono', monospace;">
                <span>{{ scan.target }}</span>
                <button onclick="window.copyText('{{ scan.target }}', this)" style="padding: 3px 8px; font-size: 11px; flex-shrink: 0;" title="Copy">Copy</button>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
                <div>
                    <div style="font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 3px;">Scan Profile</div>
                    <div class="pill" style="font-size: 10px; background: var(--info-bg); color: var(--info); border-color: var(--info-border);">{{ scan.profile | upper }} SCAN</div>
                </div>
                <div>
                    <div style="font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 3px;">Duration</div>
                    <div style="font-weight: 700; font-size: 14px; font-family: 'JetBrains Mono', monospace;">{{ scan.duration_seconds | round(1) }}s</div>
                </div>
            </div>
            <div style="font-size: 10px; color: var(--text-dim); border-top: 1px solid var(--border); padding-top: 10px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px;">
                <span>Started: {{ scan.timestamp | format_date }}</span>
                <span>ID: <code style="padding: 1px 4px; font-size: 10px;">{{ scan.scan_id }}</code></span>
            </div>
        </div>
    </div>

    {% if engagement.client %}
    <div style="border-top: 1px solid var(--border); background: rgba(5, 7, 15, 0.6); padding: 8px 24px; display: flex; justify-content: center; gap: 20px; font-size: 11px; color: var(--text-dim);">
        <span><strong>Client:</strong> {{ engagement.client }}</span>
        <span><strong>Assessor:</strong> {{ engagement.assessor }}</span>
        <span><strong>Type:</strong> {{ engagement.engagement_type }}</span>
        <span><strong>Ref:</strong> {{ engagement.reference }}</span>
    </div>
    {% endif %}
</section>

<!-- Executed Modules Modal -->
<div id="modules-modal" style="display: none; position: fixed; inset: 0; z-index: 1000; background: rgba(0,0,0,0.75); backdrop-filter: blur(8px); align-items: center; justify-content: center; padding: 24px;" onclick="if(event.target===this) this.style.display='none';">
    <div style="background: var(--card); border: 1px solid var(--border-light); border-radius: 8px; width: 100%; max-width: 700px; max-height: 80vh; display: flex; flex-direction: column; overflow: hidden;">
        <div style="padding: 16px 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between;">
            <div>
                <h3 style="margin: 0; font-size: 15px;">Executed Modules ({{ scan.modules_executed | length }})</h3>
                <div style="font-size: 11px; color: var(--text-dim); margin-top: 2px;">Security testing modules run during this assessment</div>
            </div>
            <button onclick="document.getElementById('modules-modal').style.display='none'" style="background: transparent; border: none; font-size: 18px; color: var(--text-muted); cursor: pointer; padding: 4px 8px;">&times;</button>
        </div>
        <div style="overflow-y: auto; padding: 12px 20px; flex: 1;">
            <table>
                <thead>
                    <tr>
                        <th style="padding: 6px 10px; width: 36px;">#</th>
                        <th style="padding: 6px 10px;">Module</th>
                        <th style="padding: 6px 10px; width: 70px;">Engine</th>
                        <th style="padding: 6px 10px; width: 90px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for m in scan.modules_executed %}
                    <tr>
                        <td style="padding: 6px 10px; color: var(--text-dim); font-family: monospace; font-size: 11px;">{{ loop.index }}</td>
                        <td style="padding: 6px 10px; font-weight: 600; font-size: 12px;">{{ m.name }}</td>
                        <td style="padding: 6px 10px;"><span class="pill" style="font-size: 9px;">{{ m.engine | upper }}</span></td>
                        <td style="padding: 6px 10px;">
                            <span class="pill" style="font-size: 9px; background: var(--low-bg); color: var(--low); border-color: var(--low-border);">
                                {{ m.status | upper }}
                            </span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
