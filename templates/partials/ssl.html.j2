<!-- SSL/TLS Certificate Card -->
{% if intel.ssl %}
<div class="intel-card">
    <div class="intel-card-header" onclick="window.toggleCollapsible(this)" style="border-left: 2px solid var(--sev-low); color: var(--text-secondary);">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--sev-low)" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        SSL / TLS
        {% if intel.ssl.grade %}
        <span class="pill count-pill" style="font-size: 9px; padding: 1px 6px; font-weight: 700;
            {% if intel.ssl.grade in ['A+', 'A'] %}background: var(--sev-low-bg); color: var(--sev-low); border-color: var(--sev-low-bd);
            {% elif intel.ssl.grade == 'B' %}background: var(--sev-medium-bg); color: var(--sev-medium); border-color: var(--sev-medium-bd);
            {% else %}background: var(--sev-critical-bg); color: var(--sev-critical); border-color: var(--sev-critical-bd);{% endif %}
        ">{{ intel.ssl.grade }}</span>
        {% endif %}
        <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
    <div class="intel-card-content">
        {% if intel.ssl.issuer %}
        <div class="intel-row"><span class="intel-label">Issuer</span><span class="intel-value">{{ intel.ssl.issuer }}</span></div>
        {% endif %}
        {% if intel.ssl.common_name or intel.ssl.subject %}
        <div class="intel-row"><span class="intel-label">Subject</span><span class="intel-value" style="font-family: 'JetBrains Mono', monospace; font-size: 10px;">{{ intel.ssl.common_name or intel.ssl.subject }}</span></div>
        {% endif %}
        {% if intel.ssl.expiry_days %}
        <div class="intel-row"><span class="intel-label">Valid Days</span><span class="intel-value" style="font-family: 'JetBrains Mono', monospace; font-size: 10px;">{{ intel.ssl.expiry_days }}d remaining</span></div>
        {% endif %}
        {% if intel.ssl.valid_until %}
        <div class="intel-row"><span class="intel-label">Expires</span><span class="intel-value">{{ intel.ssl.valid_until }}</span></div>
        {% endif %}

        <!-- Protocol Support Badges -->
        {% if intel.ssl.protocols %}
        <div style="margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--border);">
            <div style="font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-tertiary); margin-bottom: 4px;">Protocols</div>
            <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                {% if intel.ssl.protocols.get and intel.ssl.protocols.get('TLSv1.3') %}<span class="pill" style="font-size: 9px; background: var(--sev-low-bg); color: var(--sev-low); border-color: var(--sev-low-bd);">TLS 1.3</span>{% endif %}
                {% if intel.ssl.protocols.get and intel.ssl.protocols.get('TLSv1.2') %}<span class="pill" style="font-size: 9px; background: var(--sev-low-bg); color: var(--sev-low); border-color: var(--sev-low-bd);">TLS 1.2</span>{% endif %}
                {% if intel.ssl.protocols.get and intel.ssl.protocols.get('TLSv1.1') %}<span class="pill" style="font-size: 9px; background: var(--sev-high-bg); color: var(--sev-high); border-color: var(--sev-high-bd);">TLS 1.1</span>{% endif %}
                {% if intel.ssl.protocols.get and intel.ssl.protocols.get('TLSv1.0') %}<span class="pill" style="font-size: 9px; background: var(--sev-critical-bg); color: var(--sev-critical); border-color: var(--sev-critical-bd);">TLS 1.0</span>{% endif %}
            </div>
        </div>
        {% endif %}

        {% set sans_list = intel.ssl.sans if intel.ssl.sans is defined else (intel.ssl.san if intel.ssl.san is defined else []) %}
        {% if sans_list %}
        <div style="margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--border);">
            <div style="font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-tertiary); margin-bottom: 4px;">Subject Alternative Names</div>
            <div style="display: flex; flex-wrap: wrap; gap: 3px;">
                {% for name in sans_list[:6] %}
                <span class="pill" style="font-size: 9px; font-family: 'JetBrains Mono', monospace; padding: 2px 6px;">{{ name }}</span>
                {% endfor %}
                {% if sans_list | length > 6 %}
                <span class="pill" style="font-size: 9px; padding: 2px 6px;">+{{ sans_list | length - 6 }}</span>
                {% endif %}
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endif %}
