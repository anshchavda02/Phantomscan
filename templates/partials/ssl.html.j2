<!-- SSL/TLS Panel -->
<div class="intel-card" style="border-left: 2px solid {% if intel.ssl.grade in ['A+', 'A'] %}var(--low){% elif intel.ssl.grade in ['B', 'C'] %}var(--med){% elif intel.ssl.grade in ['D', 'F'] %}var(--crit){% else %}var(--border){% endif %};">
    <div class="intel-card-header" style="color: {% if intel.ssl.grade in ['A+', 'A'] %}var(--low){% elif intel.ssl.grade in ['B', 'C'] %}var(--med){% elif intel.ssl.grade in ['D', 'F'] %}var(--crit){% else %}var(--text){% endif %};" onclick="window.toggleCollapsible(this)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>SSL / TLS</span>
        <span style="margin-left: auto;" class="pill">Grade {{ intel.ssl.grade or 'N/A' }}</span>
    </div>
    <div class="intel-card-content">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
            <div style="width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800;
                background: {% if intel.ssl.grade in ['A+', 'A'] %}var(--low-bg){% elif intel.ssl.grade in ['B', 'C'] %}var(--med-bg){% elif intel.ssl.grade in ['D', 'F'] %}var(--crit-bg){% else %}rgba(255,255,255,0.05){% endif %};
                color: {% if intel.ssl.grade in ['A+', 'A'] %}var(--low){% elif intel.ssl.grade in ['B', 'C'] %}var(--med){% elif intel.ssl.grade in ['D', 'F'] %}var(--crit){% else %}var(--text){% endif %};
                border: 2px solid {% if intel.ssl.grade in ['A+', 'A'] %}var(--low-border){% elif intel.ssl.grade in ['B', 'C'] %}var(--med-border){% elif intel.ssl.grade in ['D', 'F'] %}var(--crit-border){% else %}var(--border){% endif %};">
                {{ intel.ssl.grade or '?' }}
            </div>
            <div>
                <span style="font-size: 10px; color: var(--text-dim); text-transform: uppercase;">Expires In</span><br>
                <span style="font-size: 16px; font-weight: 700; color: {% if intel.ssl.expiry_days is not none and intel.ssl.expiry_days > 30 %}var(--low){% elif intel.ssl.expiry_days is not none and intel.ssl.expiry_days > 7 %}var(--med){% elif intel.ssl.expiry_days is not none %}var(--crit){% else %}var(--text){% endif %};">
                    {{ intel.ssl.expiry_days if intel.ssl.expiry_days is not none else 'N/A' }} {% if intel.ssl.expiry_days is not none %}days{% endif %}
                </span>
            </div>
        </div>
        
        <div class="intel-row">
            <span class="intel-label">Issuer</span>
            <span class="intel-value" style="font-size: 10px; max-width: 170px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ intel.ssl.issuer or 'Amazon / GlobalSign' }}</span>
        </div>
        
        <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px;">
            {% if intel.ssl.protocols.get('TLSv1.3') %}<span class="pill" style="font-size: 10px; background: var(--low-bg); color: var(--low); border-color: var(--low-border);">TLS 1.3</span>{% endif %}
            {% if intel.ssl.protocols.get('TLSv1.2') %}<span class="pill" style="font-size: 10px; background: var(--low-bg); color: var(--low); border-color: var(--low-border);">TLS 1.2</span>{% endif %}
            {% if intel.ssl.protocols.get('TLSv1.1') %}<span class="pill" style="font-size: 10px; background: var(--high-bg); color: var(--high); border-color: var(--high-border);">TLS 1.1</span>{% endif %}
            {% if intel.ssl.protocols.get('TLSv1.0') %}<span class="pill" style="font-size: 10px; background: var(--crit-bg); color: var(--crit); border-color: var(--crit-border);">TLS 1.0</span>{% endif %}
        </div>
    </div>
</div>
