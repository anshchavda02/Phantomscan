<!-- Privacy & PII Exposure Section -->
<section id="privacy" class="section" style="clear: both; width: 100%;">
    <div class="section-header">
        <div style="font-size: 24px; color: var(--accent);">🔐</div>
        <h2>PRIVACY & PII EXPOSURE ANALYSIS</h2>
        <span class="pill" style="background: rgba(16, 185, 129, 0.1); color: var(--low); font-size: 11px;">GDPR / Privacy Compliance</span>
    </div>

    <div class="card" style="margin-bottom: 24px;">
        <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 20px; line-height: 1.6; text-align: left;">
            Identifies exposed Personally Identifiable Information (PII) such as emails, SSNs, credit cards, phone numbers, AWS keys, and IBANs in HTTP responses. Evidence is safely masked.
        </p>

        {% set privacy_findings = [] %}
        {% if findings %}
            {% for f in findings if f.category == 'privacy' or f.category == 'pii' or f.module == 'privacy_scanner' or f.gdpr_relevant %}
                {% set _ = privacy_findings.append(f) %}
            {% endfor %}
        {% endif %}

        {% if privacy_findings %}
        <div style="overflow-x: auto;">
            <table class="data-table" style="width: 100%; font-size: 13px;">
                <thead>
                    <tr>
                        <th style="text-align: left;">Target Endpoint</th>
                        <th style="text-align: left;">Exposure Type</th>
                        <th style="text-align: center;">Severity</th>
                        <th style="text-align: left;">Sample (Masked)</th>
                        <th style="text-align: center;">Compliance Tag</th>
                    </tr>
                </thead>
                <tbody>
                    {% for pf in privacy_findings %}
                    <tr>
                        <td><code>{{ pf.target }}</code></td>
                        <td><strong>{{ pf.title }}</strong></td>
                        <td style="text-align: center;"><span class="pill badge-{{ pf.severity|lower }}">{{ pf.severity }}</span></td>
                        <td><pre class="evidence" style="margin: 0; font-size: 11px; color: var(--accent2);">{{ pf.evidence }}</pre></td>
                        <td style="text-align: center;"><span class="pill" style="background: rgba(59, 130, 246, 0.2); color: #60a5fa; font-size: 10px;">GDPR Art. 32</span></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <div style="display: flex; align-items: center; justify-content: center; gap: 10px; padding: 20px; background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 8px; color: var(--low); font-size: 13px; font-weight: 500;">
            <span style="font-size: 16px;">✅</span>
            <span>No sensitive PII exposures detected in analyzed HTTP responses.</span>
        </div>
        {% endif %}
    </div>
</section>
