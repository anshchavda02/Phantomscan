<!-- Diff Summary Section -->
{% set new_items = diff.new_list if (diff.new_list is defined and diff.new_list) else (diff.new_findings if (diff.new_findings is iterable and not diff.new_findings is string) else []) %}
{% set res_items = diff.resolved_list if (diff.resolved_list is defined and diff.resolved_list) else (diff.resolved_findings if (diff.resolved_findings is iterable and not diff.resolved_findings is string) else []) %}
{% set new_count = new_items|length if new_items else (diff.new_findings if (diff.new_findings is number) else 0) %}
{% set res_count = res_items|length if res_items else (diff.resolved_findings if (diff.resolved_findings is number) else 0) %}

{% set has_delta = diff and (diff.score_delta is defined and diff.score_delta != 0) %}
{% set has_history = score_history is defined and score_history %}

{% if (diff and (new_count > 0 or res_count > 0 or new_items or res_items or has_delta)) or has_history %}
<section id="diff" class="section">
    <div class="section-label">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand-light)" stroke-width="2"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        <span style="color: var(--brand-light);">POSTURE DELTA &amp; DIFF SUMMARY</span>
    </div>

    {% if has_delta %}
    <div style="margin-bottom: 14px; display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-compact);">
        <span style="font-size: 11px; color: var(--text-tertiary); text-transform: uppercase; font-family: 'Syne', sans-serif;">Net Score Delta:</span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; color: {% if diff.score_delta > 0 %}var(--sev-low){% else %}var(--sev-critical){% endif %};">
            {{ '+' if diff.score_delta > 0 else '' }}{{ diff.score_delta }} pts
        </span>
    </div>
    {% endif %}

    <div class="grid-2">
        {% if new_count > 0 or new_items %}
        <div class="card" style="border-left: 3px solid var(--sev-critical);">
            <h3 style="color: var(--sev-critical); display: flex; align-items: center; gap: 8px; font-size: 13px; font-family: 'Syne', sans-serif;">
                <span>New Findings</span>
                <span class="pill badge-critical" style="margin-left: auto; font-size: 10px;">+{{ new_count }}</span>
            </h3>
            {% if new_items %}
            <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 12px;">
                {% for finding in new_items %}
                <div style="padding: 10px; background: var(--surface); border: 1px solid var(--border); border-left: 2px solid {{ finding.severity | severity_color }}; border-radius: var(--r-compact);">
                    <div style="font-weight: 600; font-size: 12.5px; margin-bottom: 4px;">{{ finding.title }}</div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <span class="pill badge-{{ finding.severity|lower }}" style="font-size: 9px;">{{ finding.severity | upper }}</span>
                        <span style="font-size: 10px; color: var(--text-tertiary);">{{ finding.category | upper }}</span>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% endif %}

        {% if res_count > 0 or res_items %}
        <div class="card" style="border-left: 3px solid var(--sev-low);">
            <h3 style="color: var(--sev-low); display: flex; align-items: center; gap: 8px; font-size: 13px; font-family: 'Syne', sans-serif;">
                <span>Resolved Findings</span>
                <span class="pill badge-low" style="margin-left: auto; font-size: 10px;">-{{ res_count }}</span>
            </h3>
            {% if res_items %}
            <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 12px;">
                {% for finding in res_items %}
                <div style="padding: 10px; background: var(--surface); border: 1px solid var(--border); border-left: 2px solid var(--sev-low); border-radius: var(--r-compact); opacity: 0.85;">
                    <div style="font-weight: 600; font-size: 12.5px; margin-bottom: 2px; text-decoration: line-through; color: var(--text-secondary);">{{ finding.title }}</div>
                    <div style="font-size: 10px; color: var(--sev-low);">Resolved since previous baseline</div>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% endif %}
    </div>

    {% if has_history %}
    <div class="card" style="margin-top: 14px;">
        <h3 style="margin: 0 0 10px 0; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--brand-light); font-family: 'Syne', sans-serif;">HISTORICAL POSTURE &amp; SCORE HISTORY</h3>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            {% for record in score_history %}
            <div style="padding: 8px 12px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-compact); display: flex; flex-direction: column; gap: 3px; min-width: 90px;">
                <span style="font-size: 10px; color: var(--text-tertiary); font-family: 'JetBrains Mono', monospace;">{{ record.date }}</span>
                <span style="font-size: 15px; font-weight: 800; font-family: 'JetBrains Mono', monospace; color: {% if record.value >= 80 %}var(--sev-low){% elif record.value >= 60 %}var(--sev-medium){% else %}var(--sev-critical){% endif %};">{{ record.value }}/100</span>
            </div>
            {% endfor %}
            <div style="padding: 8px 12px; background: var(--surface); border: 1px solid var(--border-light); border-radius: var(--r-compact); display: flex; flex-direction: column; gap: 3px; min-width: 90px; border-left: 2px solid var(--brand);">
                <span style="font-size: 10px; color: var(--brand-light); font-weight: 600; font-family: 'JetBrains Mono', monospace;">Current</span>
                <span style="font-size: 15px; font-weight: 800; font-family: 'JetBrains Mono', monospace; color: {% if score.value >= 80 %}var(--sev-low){% elif score.value >= 60 %}var(--sev-medium){% else %}var(--sev-critical){% endif %};">{{ score.value }}/100</span>
            </div>
        </div>
    </div>
    {% endif %}
</section>
{% endif %}
