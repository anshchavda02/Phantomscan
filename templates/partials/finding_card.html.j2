<!-- Finding Card Partial -->
{% set cat_slug = (finding.category | default('other') | string | lower) | replace(' ', '-') | replace('_', '-') %}
{% set card_uid = finding.uid | default('finding-' ~ (index | default(loop.index0, true)) ~ '-' ~ (finding.id | default('finding') | string | lower | replace(' ', '-') | replace(':', '-') | replace('/', '-')), true) %}
<div id="{{ card_uid }}" class="card finding-card" style="margin-bottom: 16px; border-left: 3px solid {{ finding.severity | severity_color }};" data-severity="{{ finding.severity | string | lower }}" data-finding-id="{{ finding.id }}">
    <div class="finding-header" style="display: flex; justify-content: space-between; align-items: flex-start; cursor: pointer; user-select: none;" onclick="window.toggleFindingCard(this)">
        <div style="flex: 1; padding-right: 12px;">
            <h3 style="margin: 0 0 4px 0; font-size: 14px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                {{ finding.title }}
                <span class="pill badge-{{ finding.severity | string | lower }}" style="font-size: 10px;">{{ finding.severity | string | upper }}</span>
                {% if finding.cvss_score %}
                <span class="pill badge-critical" style="font-size: 9px; font-weight: 700;">CVSS {{ finding.cvss_score }}</span>
                {% endif %}
            </h3>
            <div style="display: flex; flex-wrap: wrap; gap: 6px; font-size: 10px; color: var(--text-tertiary); align-items: center;">
                <span class="pill badge-cat badge-cat-{{ cat_slug }}">{{ finding.category | string | upper }}</span>
                {% if finding.verification_method %}
                <span class="pill" style="font-size: 9px; background: rgba(20, 184, 166, 0.1); color: var(--teal-light); border-color: rgba(20, 184, 166, 0.3);">
                    &#10003; {{ finding.verification_method | replace('_', ' ') | upper }}
                </span>
                {% endif %}
                {% if finding.confidence %}
                <span class="pill" style="font-size: 10px;">CONFIDENCE: {{ finding.confidence | string | upper }}</span>
                {% endif %}
                {% if finding.owasp_category %}
                <span class="pill" style="font-size: 9px; background: rgba(99, 102, 241, 0.1); color: #818cf8; border-color: rgba(99, 102, 241, 0.3);">{{ finding.owasp_category }}</span>
                {% endif %}
                {% if finding.fingerprint %}
                <span class="pill" style="font-size: 9px; font-family: 'JetBrains Mono', monospace;" title="SHA-256 Fingerprint: {{ finding.fingerprint }}">FP: {{ finding.fingerprint[:10] }}&hellip;</span>
                {% endif %}
                {% if finding.target %}
                <span class="pill" style="font-size: 10px; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="{{ finding.target }}">{{ finding.target }}</span>
                {% endif %}
            </div>
        </div>
        <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--text-tertiary)" stroke-width="2.5" style="margin-top: 4px; flex-shrink: 0;"><polyline points="6 9 12 15 18 9"/></svg>
    </div>

    <div class="finding-body hidden" style="border-top: 1px solid var(--border); padding-top: 14px; margin-top: 12px;">
        <!-- Tab Bar -->
        <div class="tab-bar" style="margin-bottom: 14px;">
            <div class="tab-item active" data-tab="details" onclick="window.switchFindingTab(this, 'details')">Details</div>
            <div class="tab-item" data-tab="evidence" onclick="window.switchFindingTab(this, 'evidence')">Evidence & Reproduction</div>
            <div class="tab-item" data-tab="refs" onclick="window.switchFindingTab(this, 'refs')">References ({{ (finding.references if finding.references is iterable and finding.references is not string else [finding.references]) | length }})</div>
        </div>

        <!-- Details Tab -->
        <div class="tab-content" data-tab="details">
            {% if finding.impact %}
            <div style="margin-bottom: 12px; padding: 10px 12px; background: var(--sev-critical-bg); border-left: 3px solid var(--sev-critical); border-radius: var(--r-compact);">
                <h4 style="color: var(--sev-critical); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 4px 0; font-family: 'Syne', sans-serif;">Security Impact</h4>
                <p style="margin: 0; font-size: 12px; line-height: 1.5; color: var(--text-primary);">{{ finding.impact }}</p>
            </div>
            {% endif %}

            <h4 style="color: var(--text-tertiary); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; font-family: 'Syne', sans-serif;">Remediation Recommendation</h4>
            <p style="margin-bottom: 12px; font-size: 12.5px; line-height: 1.5;">{{ finding.recommendation }}</p>

            {% if finding.remediation_guidance %}
            <div style="margin-bottom: 12px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-compact); padding: 10px 12px;">
                <h4 style="color: var(--teal-light); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 6px 0; font-family: 'Syne', sans-serif;">Code Patch Guidance</h4>
                <pre style="margin: 0; font-size: 11px; white-space: pre-wrap; word-break: break-all; font-family: 'JetBrains Mono', monospace; line-height: 1.45;">{{ finding.remediation_guidance }}</pre>
            </div>
            {% endif %}

            {% if finding.references %}
            <div style="margin-bottom: 14px; padding: 10px 12px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-compact);">
                <h4 style="color: var(--text-tertiary); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 8px 0; font-family: 'Syne', sans-serif;">Security References & Standards</h4>
                <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                    {% for ref in (finding.references if finding.references is iterable and finding.references is not string else [finding.references]) %}
                    {% set ref_link = ref | ref_url %}
                    {% set ref_name = ref | ref_title %}
                    <a href="{{ ref_link }}" target="_blank" rel="noopener noreferrer" class="pill" style="font-size: 10.5px; padding: 3px 8px; background: var(--card); border: 1px solid var(--border); color: var(--teal-light); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; border-radius: var(--r-compact);">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                        {{ ref_name }} &nearr;
                    </a>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            <!-- Action Toolbar -->
            <div style="display: flex; gap: 6px; margin-top: 12px; flex-wrap: wrap; align-items: center;">
                <a href="http://localhost:8420/verify?finding={{ finding.id }}" target="_blank" class="btn-ghost" style="text-decoration: none;">
                    &#9654; Verify Fix (Local Server)
                </a>

                <button class="btn-ghost btn-ghost-teal" onclick="document.getElementById('chat-panel-{{ card_uid }}').classList.toggle('hidden')">
                    Ask AI Assistant
                </button>

                {% if finding.badge %}
                <span class="pill badge-critical" style="font-size: 10px;">{{ finding.badge }}</span>
                {% endif %}

                {% if finding.gdpr_relevant %}
                <span class="pill" style="background: var(--sev-info-bg); color: var(--sev-info); border-color: var(--sev-info-bd); font-size: 10px;">GDPR Relevant</span>
                {% endif %}

                {% if finding.found_by %}
                <span class="pill" style="font-size: 10px;">Found by: {{ finding.found_by | join(', ') }}</span>
                {% endif %}

                {% if finding.cwe %}
                <a href="{{ finding.cwe | cwe_link }}" target="_blank" rel="noopener noreferrer" class="pill" style="font-size: 10px; text-decoration: none; color: var(--teal-light);">{{ finding.cwe }} &nearr;</a>
                {% endif %}
            </div>

            <!-- Embedded AI Chat Panel -->
            <div id="chat-panel-{{ card_uid }}" class="hidden" style="margin-top: 12px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-compact); padding: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <span style="font-size: 11px; font-weight: 700; color: var(--brand-light); font-family: 'Syne', sans-serif;">AI Security Assistant</span>
                    <span style="font-size: 10px; color: var(--text-tertiary);">
                        <span class="active-llm-indicator" style="color: var(--teal-light); font-weight: 600;">Static FAQ</span>
                        &middot;
                        <a href="#ai-assistant-settings" onclick="document.getElementById('ai-assistant-settings')?.scrollIntoView({behavior:'smooth'})" style="color: var(--text-secondary); text-decoration: underline;">Configure LLM</a>
                    </span>
                </div>
                <div id="chat-output-{{ card_uid }}" style="font-size: 11.5px; color: var(--text-primary); margin-bottom: 8px; max-height: 140px; overflow-y: auto; background: var(--card); border: 1px solid var(--border); border-radius: var(--r-compact); padding: 8px 10px; line-height: 1.5; display: none;">
                </div>
                <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 6px;">
                    <button type="button" class="pill" style="font-size: 9px; cursor: pointer; padding: 2px 6px;" onclick="document.getElementById('chat-input-{{ card_uid }}').value='How do I remediate this vulnerability?'; askFindingQuestion('{{ card_uid }}', '{{ finding.id }}')">How to fix?</button>
                    <button type="button" class="pill" style="font-size: 9px; cursor: pointer; padding: 2px 6px;" onclick="document.getElementById('chat-input-{{ card_uid }}').value='Explain the root cause and exploit scenario.'; askFindingQuestion('{{ card_uid }}', '{{ finding.id }}')">Root Cause</button>
                    <button type="button" class="pill" style="font-size: 9px; cursor: pointer; padding: 2px 6px;" onclick="document.getElementById('chat-input-{{ card_uid }}').value='Provide a secure code snippet patch.'; askFindingQuestion('{{ card_uid }}', '{{ finding.id }}')">Code Patch</button>
                </div>
                <div style="display: flex; gap: 4px;">
                    <input type="text" id="chat-input-{{ card_uid }}" placeholder="Ask AI about this finding..." style="flex: 1; background: var(--card); border: 1px solid var(--border); color: var(--text-primary); border-radius: var(--r-compact); padding: 6px 10px; font-size: 11px; font-family: inherit;" onkeypress="if(event.key==='Enter') askFindingQuestion('{{ card_uid }}', '{{ finding.id }}')">
                    <button class="btn-ghost" style="padding: 5px 12px; font-size: 11px;" onclick="askFindingQuestion('{{ card_uid }}', '{{ finding.id }}')">Ask</button>
                </div>
            </div>
        </div>

        <!-- Evidence & Reproduction Tab -->
        <div class="tab-content hidden" data-tab="evidence">
            {% if finding.reproduction_steps %}
            <div style="margin-bottom: 12px;">
                <h4 style="color: var(--text-secondary); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 6px 0; font-family: 'Syne', sans-serif;">Reproduction Steps</h4>
                <ol style="margin: 0; padding-left: 18px; font-size: 11.5px; line-height: 1.6; color: var(--text-primary);">
                    {% for step in finding.reproduction_steps %}
                    <li>{{ step }}</li>
                    {% endfor %}
                </ol>
            </div>
            {% endif %}

            {% if finding.request_sample %}
            <div style="margin-bottom: 12px;">
                <h4 style="color: var(--text-tertiary); font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 4px 0;">HTTP Request Sample</h4>
                <pre style="margin: 0; font-size: 11px; background: var(--surface); padding: 10px; border-radius: var(--r-compact); border: 1px solid var(--border); font-family: 'JetBrains Mono', monospace; white-space: pre-wrap; word-break: break-all;">{{ finding.request_sample }}</pre>
            </div>
            {% endif %}

            {% if finding.response_sample %}
            <div style="margin-bottom: 12px;">
                <h4 style="color: var(--text-tertiary); font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 4px 0;">HTTP Response Sample</h4>
                <pre style="margin: 0; font-size: 11px; background: var(--surface); padding: 10px; border-radius: var(--r-compact); border: 1px solid var(--border); font-family: 'JetBrains Mono', monospace; white-space: pre-wrap; word-break: break-all;">{{ finding.response_sample }}</pre>
            </div>
            {% endif %}

            <div>
                <h4 style="color: var(--text-tertiary); font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 4px 0;">Raw Evidence Output</h4>
                <div style="background: var(--surface); border-radius: var(--r-compact); padding: 14px; overflow-x: auto; position: relative;">
                    <button class="copy-btn" onclick="window.copyText(this.closest('.tab-content').querySelector('pre.evidence').textContent, this)" style="position: absolute; top: 8px; right: 8px; font-size: 9px; padding: 2px 6px; background: transparent; border: 1px solid var(--border); color: var(--text-tertiary); border-radius: var(--r-sharp); cursor: pointer;">COPY</button>
                    <pre class="evidence" id="evidence-{{ card_uid }}" style="margin: 0; font-size: 11px; white-space: pre-wrap; word-break: break-all; font-family: 'JetBrains Mono', 'Fira Code', monospace; line-height: 1.5;">{{ finding.evidence }}</pre>
                </div>
            </div>
        </div>

        <!-- References Tab -->
        <div class="tab-content hidden" data-tab="refs">
            <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-compact); padding: 14px;">
                <h4 style="color: var(--teal-light); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 10px 0; font-family: 'Syne', sans-serif;">Authoritative Documentation & Advisory Links</h4>
                {% if finding.references %}
                <ul style="padding-left: 0; margin: 0; font-size: 12px; list-style: none;">
                    {% for ref in (finding.references if finding.references is iterable and finding.references is not string else [finding.references]) %}
                    {% set ref_link = ref | ref_url %}
                    {% set ref_name = ref | ref_title %}
                    <li style="margin-bottom: 8px; padding: 8px 10px; background: var(--card); border: 1px solid var(--border); border-radius: var(--r-sharp); display: flex; align-items: center; justify-content: space-between; gap: 10px;">
                        <div style="display: flex; align-items: center; gap: 8px; overflow: hidden;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--teal-light)" stroke-width="2" style="flex-shrink: 0;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                            <span style="font-weight: 600; color: var(--text-primary); white-space: nowrap;">{{ ref_name }}</span>
                            <span style="color: var(--text-tertiary); font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ ref_link }}</span>
                        </div>
                        <a href="{{ ref_link }}" target="_blank" rel="noopener noreferrer" class="btn-ghost btn-ghost-teal" style="font-size: 10px; padding: 3px 8px; text-decoration: none; flex-shrink: 0;">
                            Open Link &nearr;
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p style="margin: 0; font-size: 12px; color: var(--text-secondary);">No external advisory references recorded for this finding.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

