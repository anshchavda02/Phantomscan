<!-- Finding Card Partial -->
<div id="finding-{{ index }}-{{ finding.severity|lower }}" class="card finding-card" style="margin-bottom: 24px; border-left: 4px solid {{ finding.severity | severity_color }};" data-severity="{{ finding.severity|lower }}">
    <div class="finding-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; cursor: pointer;" onclick="this.nextElementSibling.classList.toggle('hidden')">
        <div>
            <h3 style="margin: 0 0 8px 0; color: var(--text); display: flex; align-items: center; gap: 12px;">
                {{ finding.title }}
                <span class="pill badge-{{ finding.severity|lower }}" style="font-size: 10px;">{{ finding.severity }}</span>
            </h3>
            <div style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 11px; color: var(--text-muted);">
                <span>Category: {{ finding.category }}</span>
                {% if finding.confidence %}
                <span>•</span>
                <span>Confidence: {{ finding.confidence }}</span>
                {% endif %}
            </div>
        </div>
        <div style="color: var(--text-muted);">▼</div>
    </div>
    
    <div class="finding-body hidden" style="border-top: 1px solid var(--border); padding-top: 16px; margin-top: 16px;">
        <div class="grid-2">
            <div>
                <h4 style="color: var(--text-muted); font-size: 12px; text-transform: uppercase; margin-bottom: 8px;">Recommendation</h4>
                <p style="margin-bottom: 16px;">{{ finding.recommendation }}</p>
                
                {% if finding.references %}
                <h4 style="color: var(--text-muted); font-size: 12px; text-transform: uppercase; margin-bottom: 8px;">References</h4>
                <ul style="padding-left: 20px; margin-bottom: 16px;">
                    {% for ref in finding.references %}
                    <li><a href="{{ ref }}" target="_blank" rel="noopener noreferrer">{{ ref }}</a></li>
                    {% endfor %}
                </ul>
                {% endif %}

                <!-- v2.1 Action Toolbar -->
                <div style="display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap;">
                    <!-- Verify Fix (Module 12) -->
                    <a href="http://localhost:8420/verify?finding={{ finding.id }}" target="_blank" class="btn btn-secondary" style="font-size: 11px; padding: 4px 10px; text-decoration: none;">
                        🔗 Verify Fix
                    </a>

                    <!-- Ask AI Chat Toggle (Module 14) -->
                    <button class="btn btn-secondary" style="font-size: 11px; padding: 4px 10px;" onclick="document.getElementById('chat-panel-{{ index }}').classList.toggle('hidden')">
                        💬 Ask AI About Finding
                    </button>

                    {% if finding.badge %}
                    <span class="pill badge-critical" style="font-size: 10px;">{{ finding.badge }}</span>
                    {% endif %}

                    {% if finding.gdpr_relevant %}
                    <span class="pill" style="background: rgba(59, 130, 246, 0.2); color: #60a5fa; font-size: 10px;">GDPR Relevant</span>
                    {% endif %}

                    {% if finding.found_by %}
                    <span class="pill" style="background: rgba(168, 85, 247, 0.2); color: #c084fc; font-size: 10px;">Found by: {{ finding.found_by | join(', ') }}</span>
                    {% endif %}
                </div>

                <!-- Embedded AI Chat Panel (Module 14) -->
                <div id="chat-panel-{{ index }}" class="hidden" style="margin-top: 12px; background: rgba(0,0,0,0.3); border: 1px solid var(--border); border-radius: 8px; padding: 12px;">
                    <div style="font-size: 11px; font-weight: 700; color: var(--accent); margin-bottom: 6px;">🤖 Finding Assistant</div>
                    <div id="chat-output-{{ index }}" style="font-size: 12px; color: var(--text-muted); margin-bottom: 8px; max-height: 100px; overflow-y: auto;">
                        Ask a question about this vulnerability (e.g. why is this critical, how to patch).
                    </div>
                    <div style="display: flex; gap: 6px;">
                        <input type="text" id="chat-input-{{ index }}" placeholder="Ask about this finding..." style="flex: 1; background: var(--surface); border: 1px solid var(--border); color: var(--text); border-radius: 4px; padding: 4px 8px; font-size: 12px;" onkeypress="if(event.key==='Enter') askFindingQuestion('{{ index }}', '{{ finding.id }}', '{{ finding.title | escape }}')">
                        <button class="btn btn-primary" style="font-size: 11px; padding: 4px 10px;" onclick="askFindingQuestion('{{ index }}', '{{ finding.id }}', '{{ finding.title | escape }}')">Ask</button>
                    </div>
                </div>
            </div>
            
            <div style="background: rgba(0,0,0,0.2); border-radius: 8px; padding: 16px; overflow-x: auto;">
                <h4 style="color: var(--text-muted); font-size: 12px; text-transform: uppercase; margin-bottom: 8px;">Evidence & Details</h4>
                <pre class="evidence" style="margin: 0; font-size: 12px; color: var(--accent2);">{{ finding.evidence }}</pre>
                
                {% if finding.cwe %}
                <div style="margin-top: 16px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 16px;">
                    <h4 style="color: var(--text-muted); font-size: 12px; text-transform: uppercase; margin-bottom: 8px;">Tags</h4>
                    <div style="display: flex; gap: 8px;">
                        <a href="{{ finding.cwe | cwe_link }}" target="_blank" class="pill" style="background: var(--surface); color: var(--text);">{{ finding.cwe }}</a>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
