<!-- Finding Card Partial -->
{% set cat_slug = (finding.category | default('other') | lower) | replace(' ', '-') | replace('_', '-') %}
<div id="finding-{{ index }}-{{ finding.severity|lower }}" class="card finding-card" style="margin-bottom: 16px; border-left: 3px solid {{ finding.severity | severity_color }};" data-severity="{{ finding.severity|lower }}">
    <div class="finding-header" style="display: flex; justify-content: space-between; align-items: flex-start; cursor: pointer;" onclick="this.nextElementSibling.classList.toggle('hidden')">
        <div>
            <h3 style="margin: 0 0 4px 0; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                {{ finding.title }}
                <span class="pill badge-{{ finding.severity|lower }}" style="font-size: 10px;">{{ finding.severity | upper }}</span>
            </h3>
            <div style="display: flex; flex-wrap: wrap; gap: 6px; font-size: 10px; color: var(--text-dim);">
                <span class="pill badge-cat badge-cat-{{ cat_slug }}">{{ finding.category | upper }}</span>
                {% if finding.confidence %}
                <span class="pill" style="font-size: 10px;">Confidence: {{ finding.confidence | upper }}</span>
                {% endif %}
            </div>
        </div>
        <div style="color: var(--text-dim); font-size: 11px;">&#9660;</div>
    </div>
    
    <div class="finding-body hidden" style="border-top: 1px solid var(--border); padding-top: 14px; margin-top: 12px;">
        <div class="grid-2">
            <div>
                <h4 style="color: var(--text-dim); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">Recommendation</h4>
                <p style="margin-bottom: 12px; font-size: 12.5px;">{{ finding.recommendation }}</p>
                
                {% if finding.references %}
                <h4 style="color: var(--text-dim); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">References</h4>
                <ul style="padding-left: 16px; margin-bottom: 12px; font-size: 12px;">
                    {% for ref in finding.references %}
                    <li><a href="{{ ref }}" target="_blank" rel="noopener noreferrer">{{ ref }}</a></li>
                    {% endfor %}
                </ul>
                {% endif %}

                <!-- Action Toolbar -->
                <div style="display: flex; gap: 6px; margin-top: 12px; flex-wrap: wrap;">
                    <a href="http://localhost:8420/verify?finding={{ finding.id }}" target="_blank" class="btn" style="font-size: 10px; padding: 3px 8px; text-decoration: none;">
                        Verify Fix
                    </a>

                    <button class="btn" style="font-size: 10px; padding: 3px 8px;" onclick="document.getElementById('chat-panel-{{ index }}').classList.toggle('hidden')">
                        Ask AI
                    </button>

                    {% if finding.badge %}
                    <span class="pill badge-critical" style="font-size: 10px;">{{ finding.badge }}</span>
                    {% endif %}

                    {% if finding.gdpr_relevant %}
                    <span class="pill" style="background: var(--info-bg); color: var(--info); border-color: var(--info-border); font-size: 10px;">GDPR Relevant</span>
                    {% endif %}

                    {% if finding.found_by %}
                    <span class="pill" style="font-size: 10px;">Found by: {{ finding.found_by | join(', ') }}</span>
                    {% endif %}
                </div>

                <!-- Embedded AI Chat Panel -->
                <div id="chat-panel-{{ index }}" class="hidden" style="margin-top: 10px; background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: 10px;">
                    <div style="font-size: 10px; font-weight: 700; color: var(--accent); margin-bottom: 4px;">Finding Assistant</div>
                    <div id="chat-output-{{ index }}" style="font-size: 11px; color: var(--text-muted); margin-bottom: 6px; max-height: 80px; overflow-y: auto;">
                        Ask a question about this vulnerability.
                    </div>
                    <div style="display: flex; gap: 4px;">
                        <input type="text" id="chat-input-{{ index }}" placeholder="Ask about this finding..." style="flex: 1; background: var(--card); border: 1px solid var(--border); color: var(--text); border-radius: 3px; padding: 4px 6px; font-size: 11px;" onkeypress="if(event.key==='Enter') askFindingQuestion('{{ index }}', '{{ finding.id }}', '{{ finding.title | escape }}')">
                        <button class="btn" style="font-size: 10px; padding: 3px 8px;" onclick="askFindingQuestion('{{ index }}', '{{ finding.id }}', '{{ finding.title | escape }}')">Ask</button>
                    </div>
                </div>
            </div>
            
            <div style="background: var(--surface); border-radius: 4px; padding: 14px; overflow-x: auto;">
                <h4 style="color: var(--text-dim); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px;">Evidence &amp; Details</h4>
                <pre class="evidence" style="margin: 0; font-size: 11px;">{{ finding.evidence }}</pre>
                
                {% if finding.cwe %}
                <div style="margin-top: 12px; border-top: 1px solid var(--border); padding-top: 8px;">
                    <span style="color: var(--text-dim); font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em;">CWE: </span>
                    <a href="{{ finding.cwe | cwe_link }}" target="_blank" class="pill" style="font-size: 10px;">{{ finding.cwe }}</a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
