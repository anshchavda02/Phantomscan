<!-- Attack Surface Map -->
<style>
    .attack-map-container {
        margin-top: 20px;
        background: rgba(5, 7, 15, 0.6);
        border: 1px solid var(--border);
        border-radius: 6px;
        height: 380px;
        position: relative;
        overflow: hidden;
    }
    
    .light-mode .attack-map-container {
        background: rgba(248, 249, 251, 0.9);
        border-color: #dce1ea;
    }
    
    #attack-map-svg {
        width: 100%;
        height: 100%;
        display: block;
    }
    
    .map-tooltip {
        position: absolute;
        background: var(--card);
        border: 1px solid var(--accent2);
        color: var(--text);
        padding: 6px 12px;
        border-radius: 4px;
        font-size: 11px;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.1s ease;
        z-index: 20;
        box-shadow: 0 4px 16px rgba(0,0,0,0.5);
    }
    
    .light-mode .map-tooltip {
        background: #ffffff;
        border-color: #0f766e;
        color: #0f172a;
    }
    
    .map-legend {
        position: absolute;
        bottom: 12px;
        left: 12px;
        background: var(--card);
        border: 1px solid var(--border);
        padding: 8px 12px;
        border-radius: 4px;
        font-size: 10px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        z-index: 10;
        color: var(--text-muted);
    }
    
    .light-mode .map-legend {
        background: rgba(255, 255, 255, 0.95);
        border-color: #dce1ea;
        color: #475569;
    }
    
    .map-controls {
        position: absolute;
        top: 12px;
        right: 12px;
        display: flex;
        gap: 4px;
        z-index: 10;
    }
    
    .map-controls button {
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 700;
        background: var(--card);
        border: 1px solid var(--border);
        color: var(--text);
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.15s;
    }
    .map-controls button:hover {
        background: var(--accent);
        color: #ffffff;
        border-color: var(--accent);
    }
    .light-mode .map-controls button {
        background: #ffffff;
        border-color: #dce1ea;
        color: #0f172a;
    }
</style>

<div class="attack-map-container" id="attack-map-wrapper">
    <div class="map-tooltip" id="map-tooltip"></div>
    <svg id="attack-map-svg"></svg>
    <div class="map-legend">
        <div style="display: flex; align-items: center; gap: 6px;"><div style="width: 10px; height: 10px; border-radius: 50%; background: #6366f1;"></div> <span>Target Root</span></div>
        <div style="display: flex; align-items: center; gap: 6px;"><div style="width: 8px; height: 8px; border-radius: 50%; background: #0d9488;"></div> <span>Subdomain</span></div>
        <div style="display: flex; align-items: center; gap: 6px;"><div style="width: 8px; height: 8px; border-radius: 50%; background: #f97316;"></div> <span>IP Address</span></div>
        <div style="display: flex; align-items: center; gap: 6px;"><div style="width: 7px; height: 7px; border-radius: 50%; background: #3b82f6;"></div> <span>Service / Port</span></div>
        <div style="display: flex; align-items: center; gap: 6px;"><div style="width: 8px; height: 8px; background: #ef4444; transform: rotate(45deg);"></div> <span>Vulnerability</span></div>
    </div>
    <div class="map-controls">
        <button id="map-zoom-in" title="Zoom In">+</button>
        <button id="map-zoom-out" title="Zoom Out">&minus;</button>
        <button id="map-reset" title="Reset Zoom">Reset</button>
    </div>
</div>

<script>
(function() {
    function initAttackMap() {
        const container = document.getElementById('attack-map-wrapper');
        if (!container || typeof d3 === 'undefined') return;

        let d3Data = (window.state && window.state.d3Data) ? window.state.d3Data : null;
        if (!d3Data || !d3Data.nodes || d3Data.nodes.length === 0) {
            try {
                const el = document.getElementById('d3-data-json');
                if (el && el.textContent) {
                    d3Data = JSON.parse(el.textContent);
                }
            } catch(e) {}
        }

        if (!d3Data || !d3Data.nodes || d3Data.nodes.length === 0) {
            container.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-muted);font-size:12px;">Attack surface map nodes not available</div>';
            return;
        }

        const width = Math.max(container.clientWidth || 800, 600);
        const height = Math.max(container.clientHeight || 380, 300);

        try {
            d3.select("#attack-map-svg").selectAll("*").remove();

            const svg = d3.select("#attack-map-svg")
                .attr("viewBox", [0, 0, width, height]);

            const g = svg.append("g");

            const zoom = d3.zoom()
                .scaleExtent([0.2, 5])
                .on("zoom", (event) => g.attr("transform", event.transform));
            svg.call(zoom);

            const zoomInBtn = document.getElementById('map-zoom-in');
            const zoomOutBtn = document.getElementById('map-zoom-out');
            const resetBtn = document.getElementById('map-reset');

            if (zoomInBtn) zoomInBtn.onclick = () => svg.transition().duration(300).call(zoom.scaleBy, 1.4);
            if (zoomOutBtn) zoomOutBtn.onclick = () => svg.transition().duration(300).call(zoom.scaleBy, 0.7);
            if (resetBtn) resetBtn.onclick = () => svg.transition().duration(400).call(zoom.transform, d3.zoomIdentity);

            const nodes = d3Data.nodes.map(d => ({ ...d }));
            const links = d3Data.links.map(d => ({ ...d }));

            const simulation = d3.forceSimulation(nodes)
                .force("link", d3.forceLink(links).id(d => d.id).distance(75))
                .force("charge", d3.forceManyBody().strength(-280))
                .force("center", d3.forceCenter(width / 2, height / 2))
                .force("collide", d3.forceCollide().radius(25));

            const link = g.append("g")
                .selectAll("line")
                .data(links)
                .join("line")
                .style("stroke", "#243050")
                .style("stroke-opacity", 0.6)
                .style("stroke-width", d => Math.max(1.5, Math.sqrt(d.value || 1)));

            const tooltip = document.getElementById('map-tooltip');

            const node = g.append("g")
                .selectAll("path")
                .data(nodes)
                .join("path")
                .attr("d", d => {
                    if (d.type === 'vulnerability') {
                        return d3.symbol().type(d3.symbolDiamond).size(180)();
                    } else if (d.type === 'chain') {
                        return d3.symbol().type(d3.symbolStar).size(240)();
                    }
                    const r = d.type === 'target' ? 450 : (d.type === 'ip' ? 220 : 150);
                    return d3.symbol().type(d3.symbolCircle).size(r)();
                })
                .style("fill", d => {
                    if (d.type === 'target') return "#6366f1";
                    if (d.type === 'subdomain') return "#0d9488";
                    if (d.type === 'ip') return "#f97316";
                    if (d.type === 'vulnerability') return "#ef4444";
                    if (d.type === 'chain') return "#dc2626";
                    return "#3b82f6";
                })
                .style("stroke", "#05070f")
                .style("stroke-width", 1.5)
                .style("cursor", "grab")
                .call(d3.drag()
                    .on("start", (event) => {
                        if (!event.active) simulation.alphaTarget(0.3).restart();
                        event.subject.fx = event.subject.x;
                        event.subject.fy = event.subject.y;
                    })
                    .on("drag", (event) => {
                        event.subject.fx = event.x;
                        event.subject.fy = event.y;
                    })
                    .on("end", (event) => {
                        if (!event.active) simulation.alphaTarget(0);
                        event.subject.fx = null;
                        event.subject.fy = null;
                    })
                );

            const label = g.append("g")
                .selectAll("text")
                .data(nodes)
                .join("text")
                .attr("dy", 14)
                .attr("text-anchor", "middle")
                .text(d => d.name || d.id)
                .style("font-size", "10px")
                .style("font-weight", "600")
                .style("fill", "#e2e8f0")
                .style("pointer-events", "none")
                .style("text-shadow", "0 1px 3px rgba(0,0,0,0.9)");

            node.on("mouseover", (event, d) => {
                if (tooltip) {
                    tooltip.innerHTML = `<strong>${d.name || d.id}</strong><br><span style="color:var(--text-dim);font-size:10px;">Type: ${d.type || 'Node'}</span>`;
                    tooltip.style.opacity = 1;
                    tooltip.style.left = (event.offsetX + 12) + "px";
                    tooltip.style.top = (event.offsetY - 12) + "px";
                }

                const connected = new Set();
                connected.add(d.id);
                link.style("stroke", l => {
                    const src = l.source.id || l.source;
                    const tgt = l.target.id || l.target;
                    if (src === d.id || tgt === d.id) {
                        connected.add(src);
                        connected.add(tgt);
                        return "#3b82f6";
                    }
                    return "#1a2035";
                }).style("stroke-opacity", l => {
                    const src = l.source.id || l.source;
                    const tgt = l.target.id || l.target;
                    return (src === d.id || tgt === d.id) ? 1 : 0.15;
                });

                node.style("opacity", n => connected.has(n.id) ? 1 : 0.2);
                label.style("opacity", n => connected.has(n.id) ? 1 : 0.15);
            })
            .on("mouseout", () => {
                if (tooltip) tooltip.style.opacity = 0;
                link.style("stroke", "#243050").style("stroke-opacity", 0.6);
                node.style("opacity", 1);
                label.style("opacity", 1);
            });

            simulation.on("tick", () => {
                link
                    .attr("x1", d => d.source.x)
                    .attr("y1", d => d.source.y)
                    .attr("x2", d => d.target.x)
                    .attr("y2", d => d.target.y);

                node.attr("transform", d => `translate(${d.x},${d.y})`);
                label.attr("x", d => d.x).attr("y", d => d.y);
            });

        } catch (err) {
            console.error("D3 Attack Map error:", err);
            container.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-muted);font-size:12px;">Attack Map visual simulation initialized</div>';
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAttackMap);
    } else {
        initAttackMap();
    }
})();
</script>
