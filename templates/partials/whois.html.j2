<!-- WHOIS Panel -->
<div class="intel-card" style="border-left: 2px solid var(--mod-recon);">
    <div class="intel-card-header" style="color: var(--mod-recon);" onclick="window.toggleCollapsible(this)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <span>WHOIS</span>
        <span style="margin-left: auto;">{{ intel.whois.country | flag_emoji }}</span>
    </div>
    <div class="intel-card-content">
        <div class="intel-row">
            <span class="intel-label">Registrar</span>
            <span class="intel-value">{{ intel.whois.registrar or 'N/A' }}</span>
        </div>
        <div class="intel-row">
            <span class="intel-label">Registered</span>
            <span class="intel-value">{{ intel.whois.registration_date[:10] if intel.whois.registration_date else 'N/A' }}</span>
        </div>
        <div class="intel-row">
            <span class="intel-label">Expires</span>
            <span class="intel-value" style="color: {% if intel.whois.days_remaining is not none and intel.whois.days_remaining > 180 %}var(--low){% elif intel.whois.days_remaining is not none and intel.whois.days_remaining > 90 %}var(--med){% elif intel.whois.days_remaining is not none %}var(--crit){% else %}var(--text){% endif %}; font-weight: 700;">
                {{ intel.whois.expiry_date[:10] if intel.whois.expiry_date else 'N/A' }}{% if intel.whois.days_remaining is not none %} ({{ intel.whois.days_remaining }}d){% endif %}
            </span>
        </div>
        <div class="intel-row">
            <span class="intel-label">DNSSEC</span>
            <span class="intel-value" style="color: {% if intel.whois.dnssec %}var(--low){% else %}var(--crit){% endif %};">{{ 'Enabled' if intel.whois.dnssec else 'Disabled' }}</span>
        </div>
    </div>
</div>
