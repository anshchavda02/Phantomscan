<!-- Remediation Matrix Section -->
{% if findings %}
<section id="remediation" class="section">
    <div class="section-header" style="border-left-color: var(--low);">
        <svg class="sec-icon" style="color: var(--low);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        <h2>Remediation Matrix</h2>
    </div>

    <div class="card" style="padding: 0; overflow: hidden;">
        <div style="padding: 12px 16px; background: var(--surface); border-bottom: 1px solid var(--border); font-size: 11.5px; color: var(--text-muted);">
            Prioritized list of actionable remediation steps based on finding severity and exploitability.
        </div>
        
        <div style="overflow-x: auto;">
            <table>
                <thead>
                    <tr>
                        <th style="width: 90px;">Priority</th>
                        <th>Finding</th>
                        <th style="width: 110px;">Category</th>
                        <th>Remediation Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for severity in ['Critical', 'High', 'Medium', 'Low', 'Info'] %}
                        {% for finding in findings if finding.severity|lower == severity|lower %}
                        {% set cat_slug = (finding.category | default('other') | lower) | replace(' ', '-') | replace('_', '-') %}
                        <tr>
                            <td>
                                <span class="pill badge-{{ finding.severity|lower }}" style="font-size: 10px;">
                                    {{ finding.severity | upper }}
                                </span>
                            </td>
                            <td>
                                <a href="#finding-{{ loop.index }}-{{ finding.severity|lower }}" style="font-weight: 600; color: var(--text); text-decoration: none;">
                                    {{ finding.title }}
                                </a>
                            </td>
                            <td>
                                <span class="pill badge-cat badge-cat-{{ cat_slug }}">
                                    {{ finding.category | upper }}
                                </span>
                            </td>
                            <td style="color: var(--text-muted); font-size: 12px;">
                                {{ finding.recommendation | truncate_evidence(180) }}
                            </td>
                        </tr>
                        {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</section>
{% endif %}
