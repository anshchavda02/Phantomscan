<!-- False Positives / Suppressed Findings Section -->
<section id="suppressed" class="section">
    <div class="section-header" style="border-left-color: var(--accent); justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <svg class="sec-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <h2 style="margin: 0;">Suppressed Findings</h2>
            <span class="pill" style="background: var(--accent-glow); border-color: var(--accent); color: var(--accent-light); font-weight: 700;">
                {{ fp_log | length }} Suppressed
            </span>
        </div>
        
        <div style="display: flex; align-items: center; gap: 8px;">
            <input type="text" id="fp-search-box" placeholder="Filter suppressed..." 
                   oninput="window.filterSuppressedFindings(this.value)" 
                   style="background: var(--surface); border: 1px solid var(--border); color: var(--text); padding: 5px 10px; border-radius: 4px; font-size: 11px; min-width: 200px;">
        </div>
    </div>

    <!-- FP Analytics & Gate Intelligence Cards -->
    <div class="grid-4" style="margin-bottom: 20px;">
        <div class="card" style="padding: 14px;">
            <div style="font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em;">Total Raw Candidates</div>
            <div style="font-size: 22px; font-weight: 800; font-family: 'JetBrains Mono', monospace;">
                {{ (findings | length) + (fp_log | length) }}
            </div>
            <div style="font-size: 10px; color: var(--text-dim);">Evaluated by scanner modules</div>
        </div>

        <div class="card" style="padding: 14px; border-left: 2px solid var(--low);">
            <div style="font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em;">Confirmed Real</div>
            <div style="font-size: 22px; font-weight: 800; font-family: 'JetBrains Mono', monospace; color: var(--low);">
                {{ findings | length }}
            </div>
            <div style="font-size: 10px; color: var(--low);">Passed deterministic validation</div>
        </div>

        <div class="card" style="padding: 14px; border-left: 2px solid var(--accent-light);">
            <div style="font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em;">Suppressed FP</div>
            <div style="font-size: 22px; font-weight: 800; font-family: 'JetBrains Mono', monospace; color: var(--accent-light);">
                {{ fp_log | length }}
            </div>
            <div style="font-size: 10px; color: var(--accent-light);">Filtered by gate &amp; platform</div>
        </div>

        <div class="card" style="padding: 14px; border-left: 2px solid var(--accent2);">
            <div style="font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em;">FP Elimination Rate</div>
            <div style="font-size: 22px; font-weight: 800; font-family: 'JetBrains Mono', monospace; color: var(--accent2);">
                {% if (findings | length) + (fp_log | length) > 0 %}
                    {{ (((fp_log | length) / ((findings | length) + (fp_log | length))) * 100) | round(1) }}%
                {% else %}
                    0.0%
                {% endif %}
            </div>
            <div style="font-size: 10px; color: var(--text-dim);">Score protected from inflation</div>
        </div>
    </div>

    {% if fp_log and fp_log | length > 0 %}
    <!-- Filter Category Pills -->
    <div style="display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap;" id="fp-filter-buttons">
        <button class="pill" onclick="window.setFPFilter('all')" id="fp-btn-all" style="cursor: pointer; background: var(--accent); color: #ffffff; border-color: var(--accent);">
            All ({{ fp_log | length }})
        </button>
        <button class="pill" onclick="window.setFPFilter('gate')" id="fp-btn-gate" style="cursor: pointer;">
            FindingGate
        </button>
        <button class="pill" onclick="window.setFPFilter('platform')" id="fp-btn-platform" style="cursor: pointer;">
            Platform
        </button>
        <button class="pill" onclick="window.setFPFilter('confidence')" id="fp-btn-confidence" style="cursor: pointer;">
            Confidence Floor
        </button>
    </div>

    <!-- Suppressed Findings Table & Inspector -->
    <div class="card" style="padding: 0; overflow: hidden;">
        <div style="padding: 10px 16px; background: var(--surface); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--text-dim);">
            <span style="font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em;">
                AUDIT LOG: CANDIDATE VULNERABILITIES REJECTED
            </span>
            <span>Click row to inspect</span>
        </div>

        <div style="overflow-x: auto;">
            <table id="fp-table">
                <thead>
                    <tr>
                        <th style="width: 36px;">#</th>
                        <th>Candidate Vulnerability</th>
                        <th style="width: 90px;">Severity</th>
                        <th>Endpoint</th>
                        <th>Suppression Rationale</th>
                        <th style="width: 64px; text-align: center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for fp in fp_log %}
                    {% set fp_reason = fp.suppression_reason or fp.gate_rejection_reason or fp.reason or 'Filtered by Quality Invariant' %}
                    {% set fp_type = 'gate' if (fp.gate_rejection_reason or 'field' in fp_reason|lower or 'evidence' in fp_reason|lower or 'confidence' in fp_reason|lower and 'invalid' in fp_reason|lower) else ('confidence' if 'confidence' in fp_reason|lower else 'platform') %}
                    
                    <tr class="fp-row" data-type="{{ fp_type }}" data-search="{{ (fp.title ~ ' ' ~ fp.target ~ ' ' ~ fp_reason) | lower }}" 
                        style="cursor: pointer;"
                        onclick="window.toggleFPDetails('fp-detail-{{ loop.index }}')">
                        
                        <td style="font-family: monospace; color: var(--text-dim);">{{ loop.index }}</td>
                        
                        <td>
                            <div style="font-weight: 700;">
                                <span>{{ fp.title or fp.id or 'Unnamed Candidate' }}</span>
                            </div>
                            {% if fp.id %}
                            <div style="font-size: 10px; color: var(--text-dim); font-family: monospace; margin-top: 1px;">
                                ID: {{ fp.id }}
                            </div>
                            {% endif %}
                        </td>
                        
                        <td>
                            <span class="pill badge-{{ (fp.severity | lower) if fp.severity else 'medium' }}" style="font-size: 10px; text-transform: uppercase;">
                                {{ fp.severity or 'medium' }}
                            </span>
                        </td>
                        
                        <td style="font-family: monospace; font-size: 10px; color: var(--accent2); word-break: break-all; max-width: 220px;">
                            {{ fp.target or scan.target }}
                        </td>
                        
                        <td>
                            <span class="pill" style="font-size: 9px; background: {% if fp_type == 'gate' %}var(--crit-bg); color: var(--crit); border-color: var(--crit-border);{% elif fp_type == 'platform' %}var(--info-bg); color: var(--info); border-color: var(--info-border);{% else %}var(--med-bg); color: var(--med); border-color: var(--med-border);{% endif %}">
                                {{ 'FINDING_GATE' if fp_type == 'gate' else ('PLATFORM_RULE' if fp_type == 'platform' else 'CONFIDENCE') }}
                            </span>
                            <span style="color: var(--text-muted); font-size: 11px;">{{ fp_reason }}</span>
                        </td>
                        
                        <td style="text-align: center;">
                            <button class="btn" style="padding: 2px 6px; font-size: 10px;" onclick="event.stopPropagation(); window.toggleFPDetails('fp-detail-{{ loop.index }}')">
                                View
                            </button>
                        </td>
                    </tr>

                    <!-- Expandable Details Drawer -->
                    <tr id="fp-detail-{{ loop.index }}" class="fp-detail-row" style="display: none; background: var(--surface);">
                        <td colspan="6" style="padding: 14px 16px;">
                            <div style="display: flex; flex-direction: column; gap: 10px;">
                                <div>
                                    <div style="font-size: 10px; text-transform: uppercase; color: var(--text-dim); font-weight: 600; margin-bottom: 3px;">
                                        Why suppressed:
                                    </div>
                                    <div style="font-size: 12px; color: var(--accent-light); font-weight: 600;">
                                        {{ fp_reason }}
                                    </div>
                                </div>

                                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                    {% if fp.confidence %}
                                    <span class="pill" style="font-size: 10px;">Confidence: {{ fp.confidence | upper }}</span>
                                    {% endif %}
                                    {% if fp.verification_method %}
                                    <span class="pill" style="font-size: 10px;">Method: {{ fp.verification_method }}</span>
                                    {% endif %}
                                    {% if fp.category %}
                                    <span class="pill" style="font-size: 10px;">Category: {{ fp.category }}</span>
                                    {% endif %}
                                </div>

                                {% if fp.evidence %}
                                <div>
                                    <div style="font-size: 10px; text-transform: uppercase; color: var(--text-dim); font-weight: 600; margin-bottom: 4px;">
                                        Raw Evidence:
                                    </div>
                                    <pre class="evidence" style="margin: 0; max-height: 140px; overflow-y: auto; font-size: 10px;">{{ fp.evidence }}</pre>
                                </div>
                                {% endif %}

                                {% if fp.recommendation %}
                                <div style="font-size: 10px; color: var(--text-dim);">
                                    <strong>Remediation:</strong> {{ fp.recommendation }}
                                </div>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% else %}
    <!-- Zero Suppressed State -->
    <div class="card" style="text-align: center; padding: 28px 20px;">
        <div style="font-size: 24px; margin-bottom: 8px;">🛡️</div>
        <h3 style="margin: 0 0 6px 0; color: var(--text); font-size: 14px;">Zero False Positives Triggered</h3>
        <p style="margin: 0; color: var(--text-dim); font-size: 12px; max-width: 560px; margin: 0 auto;">
            All findings satisfied strict multi-layer verification gates and baseline differential checks.
        </p>
    </div>
    {% endif %}
</section>
