<!-- Screenshots Section -->
{% if screenshots %}
<section id="screenshots" class="section">
    <div class="section-label">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--teal)" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        <span style="color: var(--teal);">EVIDENCE &amp; SCREENSHOTS</span>
    </div>

    <div class="grid-3">
        {% for ss in screenshots %}
        <div class="card" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
            <div style="height: 180px; background: var(--surface); display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid var(--border);">
                <img src="{{ ss.data_uri }}" alt="{{ ss.description }}" style="max-width: 100%; max-height: 100%; object-fit: contain; cursor: pointer;" onclick="window.open(this.src, '_blank')">
            </div>
            <div style="padding: 14px;">
                <h4 style="margin: 0 0 6px 0; font-size: 13px; font-family: 'Syne', sans-serif;">{{ ss.title }}</h4>
                <p style="margin: 0 0 10px 0; font-size: 11.5px; color: var(--text-secondary);">{{ ss.description }}</p>
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10px;">
                    <span class="pill" style="font-family: 'JetBrains Mono', monospace; font-size: 9px;">{{ ss.timestamp | format_date }}</span>
                    {% if ss.related_finding_id %}
                    <a href="#finding-{{ ss.related_finding_id }}" style="color: var(--teal-light); font-weight: 600;">View Finding &rarr;</a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</section>
{% endif %}
