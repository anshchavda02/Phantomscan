<!-- Scan Metadata & Engine Logs Section -->
<section id="metadata" class="section">
    <div class="section-header">
        <div style="font-size: 24px; color: var(--text-muted);">⚙️</div>
        <h2>SCAN METADATA</h2>
    </div>

    <div class="card">
        <div class="grid-2">
            <div>
                <h4 style="color: var(--text-muted); font-size: 12px; text-transform: uppercase; margin-bottom: 8px;">Scan Configuration</h4>
                <div class="intel-row"><span class="intel-label">Profile</span><span class="intel-value">{{ scan.profile }}</span></div>
                <div class="intel-row"><span class="intel-label">Report Version</span><span class="intel-value">{{ report_version }}</span></div>
                <div class="intel-row"><span class="intel-label">Scan ID</span><span class="intel-value" style="font-family: 'JetBrains Mono', monospace; font-size: 11px;">{{ scan.scan_id }}</span></div>
                <div class="intel-row"><span class="intel-label">Total Duration</span><span class="intel-value">{{ scan.duration_seconds | round(2) }}s</span></div>
                {% if scan_metadata and scan_metadata.cache_hit_rate is defined %}
                <div class="intel-row"><span class="intel-label">Cache Hit Rate</span><span class="intel-value">{{ (scan_metadata.cache_hit_rate * 100) | round(1) }}%</span></div>
                {% endif %}
                {% if scan_metadata and scan_metadata.circuit_breakers_opened %}
                <div class="intel-row"><span class="intel-label">Circuit Breakers</span><span class="intel-value" style="color: var(--crit); font-weight: bold;">OPEN: {{ scan_metadata.circuit_breakers_opened | join(', ') }}</span></div>
                {% endif %}
                {% if scan_metadata and scan_metadata.degradation_active %}
                <div class="intel-row"><span class="intel-label">Active Degradation</span><span class="intel-value" style="color: var(--med);">{{ scan_metadata.degradation_active | length }} fallback(s) active</span></div>
                {% endif %}
            </div>
            
            <div>
                <h4 style="color: var(--text-muted); font-size: 12px; text-transform: uppercase; margin-bottom: 8px;">Engine Diagnostics</h4>
                <div style="background: rgba(0,0,0,0.4); padding: 12px; border-radius: 4px; font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--text-muted); max-height: 150px; overflow-y: auto;">
                    {% for mod in scan.modules_executed %}
                    <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                        <span>[{{ mod.timestamp }}] {{ mod.engine }}::{{ mod.name }}</span>
                        <span style="color: {% if mod.status == 'completed' %}var(--low){% elif mod.status == 'failed' %}var(--crit){% else %}var(--med){% endif %};">{{ mod.status|upper }}</span>
                    </div>
                    {% if mod.error %}
                    <div style="color: var(--crit); margin-left: 12px; margin-bottom: 4px; border-left: 1px solid var(--crit); padding-left: 8px;">Error: {{ mod.error }}</div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>
