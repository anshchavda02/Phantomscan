<!-- IP Intelligence Card -->
{% if intel.ip_info %}
<div class="intel-card">
    <div class="intel-card-header" onclick="window.toggleCollapsible(this)" style="border-left: 2px solid #f97316; color: var(--text-secondary);">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
        IP INTELLIGENCE
        <span class="pill count-pill" style="font-size: 9px; padding: 1px 6px;">{{ intel.ip_info | length }}</span>
        <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
    <div class="intel-card-content">
        {% for ip_item in intel.ip_info %}
        {% set ip_addr = ip_item.ip if ip_item.ip is defined else (ip_item.address if ip_item.address is defined else ip_item) %}
        <div style="{% if not loop.first %}margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border);{% endif %}">
            <div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">{{ ip_addr }}</div>
            {% if ip_item.asn %}
            <div class="intel-row"><span class="intel-label">ASN</span><span class="intel-value" style="font-family: 'JetBrains Mono', monospace; font-size: 10px;">{{ ip_item.asn }}</span></div>
            {% endif %}
            {% if ip_item.org or ip_item.organization %}
            <div class="intel-row"><span class="intel-label">Org</span><span class="intel-value">{{ ip_item.org or ip_item.organization }}</span></div>
            {% endif %}
            {% if ip_item.hosting %}
            <div class="intel-row"><span class="intel-label">Provider</span><span class="intel-value">{{ ip_item.hosting }}</span></div>
            {% endif %}
            {% if ip_item.country %}
            <div class="intel-row"><span class="intel-label">Location</span><span class="intel-value">{{ ip_item.country | country_flag }} {{ ip_item.city | default('') }}{% if ip_item.city %}, {% endif %}{{ ip_item.country }}</span></div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}
