<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PhantomScan Security Report - {{ scan.target }}</title>
    <meta name="description" content="PhantomScan Authorized Security Assessment Report">
    <meta name="version" content="{{ report_version }}">
    <meta name="generator" content="PhantomScan">
    
    <!-- Dependencies with SRI & fallbacks -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js" integrity="sha512-ElRFoEQdI5Ht6kZvyzXhYG9NqjtkmlkfYk0wr6wHxU9JEHakS7UJZNeml5ALk+8IKlU6jDgMabC3vkumRokgJA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js" integrity="sha512-M7nHCiNUOwFt6Us3r8alutZLm9qMt4s9951uo8jqO4UwJ1hziseL6O3ndFyigx6+LREfZqnhHxYjKRJ8ZQ69DQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    
    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">

    <style>
        /* ═══════════════════════════════════════════════════════
           PhantomScan Enterprise Report — Design System v3.0
           ═══════════════════════════════════════════════════════ */
        :root {
            --bg:            #05070f;
            --surface:       #0a0d1a;
            --card:          #0e1225;
            --card-hover:    #121830;
            --card-raised:   #151b35;
            --nav-bg:        rgba(5, 7, 15, 0.92);
            --border:        #1a2035;
            --border-light:  #243050;
            --border-glow:   #2e3d62;
            --text:          #e2e8f0;
            --text-muted:    #8892a4;
            --text-dim:      #5a6478;
            --accent:        #2563eb;
            --accent-light:  #3b82f6;
            --accent-glow:   rgba(37, 99, 235, 0.25);
            --accent2:       #0d9488;
            --accent2-glow:  rgba(13, 148, 136, 0.25);
            --accent3:       #dc2626;
            --accent3-glow:  rgba(220, 38, 38, 0.25);
            --crit:          #ef4444;
            --crit-bg:       rgba(239, 68, 68, 0.08);
            --crit-border:   rgba(239, 68, 68, 0.3);
            --crit-glow:     rgba(239, 68, 68, 0.15);
            --high:          #f97316;
            --high-bg:       rgba(249, 115, 22, 0.08);
            --high-border:   rgba(249, 115, 22, 0.3);
            --high-glow:     rgba(249, 115, 22, 0.15);
            --med:           #eab308;
            --med-bg:        rgba(234, 179, 8, 0.08);
            --med-border:    rgba(234, 179, 8, 0.3);
            --med-glow:      rgba(234, 179, 8, 0.15);
            --low:           #22c55e;
            --low-bg:        rgba(34, 197, 94, 0.08);
            --low-border:    rgba(34, 197, 94, 0.3);
            --low-glow:      rgba(34, 197, 94, 0.15);
            --info:          #3b82f6;
            --info-bg:       rgba(59, 130, 246, 0.08);
            --info-border:   rgba(59, 130, 246, 0.3);
            --info-glow:     rgba(59, 130, 246, 0.15);
            --mod-recon:     #0d9488;
            --mod-web:       #6366f1;
            --mod-network:   #f97316;
            --mod-ssl:       #22c55e;
            --mod-cve:       #ef4444;
            --mod-api:       #3b82f6;
            --mod-chain:     #dc2626;
            --mod-jwt:       #7c3aed;
            --mod-ssrf:      #ea580c;
            --mod-sqli:      #b91c1c;
            --mod-xss:       #d97706;
            --mod-cloud:     #0284c7;
            --mod-supply:    #15803d;
            --mod-logic:     #7c3aed;
            --mod-idor:      #c2410c;
            --mod-race:      #0891b2;
            --mod-ws:        #6d28d9;
            --mod-graphql:   #e11d48;
            --mod-proto:     #047857;
            --mod-smuggle:   #92400e;
            --mod-oob:       #1d4ed8;
            --mod-intel:     #065f46;
        }

        :root.light-mode {
            --bg:            #f8f9fb;
            --surface:       #eef1f6;
            --card:          #ffffff;
            --card-hover:    #f8f9fb;
            --card-raised:   #ffffff;
            --nav-bg:        rgba(248, 249, 251, 0.92);
            --border:        #dce1ea;
            --border-light:  #c5cdd8;
            --border-glow:   #a0aab8;
            --text:          #0f172a;
            --text-muted:    #475569;
            --text-dim:      #64748b;
            --accent:        #1d4ed8;
            --accent-light:  #2563eb;
            --accent-glow:   rgba(29, 78, 216, 0.15);
            --accent2:       #0f766e;
            --accent2-glow:  rgba(15, 118, 110, 0.15);
            --accent3:       #dc2626;
            --accent3-glow:  rgba(220, 38, 38, 0.15);
            --crit:          #dc2626;  --crit-bg: #fef2f2;  --crit-border: #fca5a5;  --crit-glow: rgba(220, 38, 38, 0.1);
            --high:          #ea580c;  --high-bg: #fff7ed;  --high-border: #fdba74;  --high-glow: rgba(234, 88, 12, 0.1);
            --med:           #ca8a04;  --med-bg:  #fefce8;  --med-border:  #fde047;  --med-glow:  rgba(202, 138, 4, 0.1);
            --low:           #16a34a;  --low-bg:  #f0fdf4;  --low-border:  #86efac;  --low-glow:  rgba(22, 163, 74, 0.1);
            --info:          #2563eb;  --info-bg: #eff6ff;  --info-border: #93c5fd;  --info-glow: rgba(37, 99, 235, 0.1);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            font-size: 13.5px;
            line-height: 1.55;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* Headings */
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Syne', 'Inter', sans-serif;
            color: var(--text);
            font-weight: 700;
            letter-spacing: -0.01em;
            line-height: 1.25;
            margin-bottom: 0.75rem;
        }

        p, span, div, td, th { color: inherit; }

        a { color: var(--accent-light); text-decoration: none; transition: color 0.15s; }
        a:hover { color: var(--accent2); }

        /* Code */
        code, pre, .evidence {
            font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
            background: var(--surface);
            color: var(--accent2);
            border: 1px solid var(--border);
            padding: 2px 6px;
            border-radius: 3px;
            white-space: pre-wrap;
            word-break: break-all;
            overflow-wrap: anywhere;
            font-size: 12px;
        }
        .light-mode code, .light-mode pre, .light-mode .evidence {
            background: #f1f5f9; color: #0f766e; border-color: #dce1ea;
        }

        .hidden { display: none !important; }

        /* Card */
        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 20px;
            color: var(--text);
            transition: border-color 0.15s;
        }
        .card:hover { border-color: var(--border-light); }
        .light-mode .card, .light-mode .intel-card {
            background: #ffffff; border-color: #dce1ea; color: #0f172a;
        }

        /* Pill / Badge */
        .pill {
            display: inline-flex; align-items: center; justify-content: center;
            padding: 3px 8px; border-radius: 3px; font-size: 11px; font-weight: 600;
            background: var(--surface); border: 1px solid var(--border); color: var(--text-muted);
            white-space: nowrap; letter-spacing: 0.02em;
        }

        /* Severity Badges */
        .badge-critical, .pill.badge-critical { background: var(--crit-bg) !important; border-color: var(--crit-border) !important; color: var(--crit) !important; font-weight: 700 !important; }
        .badge-high, .pill.badge-high { background: var(--high-bg) !important; border-color: var(--high-border) !important; color: var(--high) !important; font-weight: 700 !important; }
        .badge-medium, .pill.badge-medium { background: var(--med-bg) !important; border-color: var(--med-border) !important; color: var(--med) !important; font-weight: 700 !important; }
        .badge-low, .pill.badge-low { background: var(--low-bg) !important; border-color: var(--low-border) !important; color: var(--low) !important; font-weight: 700 !important; }
        .badge-info, .pill.badge-info { background: var(--info-bg) !important; border-color: var(--info-border) !important; color: var(--info) !important; font-weight: 700 !important; }

        /* Category Badges */
        .badge-cat, .pill.badge-cat { font-size: 10px !important; font-weight: 600 !important; padding: 2px 6px !important; border-radius: 3px !important; text-transform: uppercase !important; letter-spacing: 0.04em !important; }
        .badge-cat-web, .pill.badge-cat-web { background: rgba(99, 102, 241, 0.1) !important; border-color: rgba(99, 102, 241, 0.3) !important; color: #818cf8 !important; }
        .badge-cat-network, .pill.badge-cat-network { background: rgba(249, 115, 22, 0.1) !important; border-color: rgba(249, 115, 22, 0.3) !important; color: #fb923c !important; }
        .badge-cat-ssl, .pill.badge-cat-ssl { background: rgba(34, 197, 94, 0.1) !important; border-color: rgba(34, 197, 94, 0.3) !important; color: #4ade80 !important; }
        .badge-cat-email, .pill.badge-cat-email { background: rgba(234, 88, 12, 0.1) !important; border-color: rgba(234, 88, 12, 0.3) !important; color: #fb923c !important; }
        .badge-cat-auth, .pill.badge-cat-auth { background: rgba(124, 58, 237, 0.1) !important; border-color: rgba(124, 58, 237, 0.3) !important; color: #a78bfa !important; }
        .badge-cat-api, .pill.badge-cat-api { background: rgba(13, 148, 136, 0.1) !important; border-color: rgba(13, 148, 136, 0.3) !important; color: #2dd4bf !important; }
        .badge-cat-supply-chain, .badge-cat-supply_chain, .pill.badge-cat-supply-chain, .pill.badge-cat-supply_chain { background: rgba(21, 128, 61, 0.1) !important; border-color: rgba(21, 128, 61, 0.3) !important; color: #4ade80 !important; }
        .badge-cat-compliance, .pill.badge-cat-compliance { background: rgba(99, 102, 241, 0.1) !important; border-color: rgba(99, 102, 241, 0.3) !important; color: #a5b4fc !important; }
        .badge-cat-cve, .pill.badge-cat-cve { background: rgba(239, 68, 68, 0.1) !important; border-color: rgba(239, 68, 68, 0.3) !important; color: #f87171 !important; }
        .badge-cat-cloud, .pill.badge-cat-cloud { background: rgba(2, 132, 199, 0.1) !important; border-color: rgba(2, 132, 199, 0.3) !important; color: #38bdf8 !important; }
        .badge-cat-reporting, .pill.badge-cat-reporting { background: rgba(99, 102, 241, 0.1) !important; border-color: rgba(99, 102, 241, 0.3) !important; color: #a5b4fc !important; }

        .container { max-width: 1320px; margin: 0 auto; padding: 0 24px; }
        .section { margin-bottom: 56px; }

        .section-header {
            display: flex; align-items: center; gap: 10px;
            margin-bottom: 20px; padding-bottom: 10px; padding-left: 14px;
            border-bottom: 1px solid var(--border);
            border-left: 3px solid var(--accent);
        }
        .section-header .sec-icon { width: 20px; height: 20px; color: var(--accent); flex-shrink: 0; }
        .section-header h2 { margin: 0; font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; }

        button, .btn {
            background: var(--surface); color: var(--text); border: 1px solid var(--border);
            padding: 6px 12px; border-radius: 4px; font-family: inherit; font-weight: 500;
            cursor: pointer; transition: all 0.15s; display: inline-flex; align-items: center; justify-content: center; gap: 5px; font-size: 12px;
        }
        button:hover, .btn:hover { background: var(--card-raised); border-color: var(--border-light); }

        .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

        @media (max-width: 1200px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 768px) { .grid-3, .grid-4, .grid-2 { grid-template-columns: 1fr; } .card { padding: 14px; } }

        /* Tables */
        table { width: 100%; border-collapse: collapse; }
        th {
            color: var(--text-muted); border-bottom: 2px solid var(--border);
            padding: 8px 12px; font-size: 10px; text-transform: uppercase;
            letter-spacing: 0.06em; text-align: left; font-weight: 700;
            background: rgba(0,0,0,0.15);
        }
        td {
            color: var(--text); border-bottom: 1px solid var(--border);
            padding: 10px 12px; font-size: 12.5px;
        }
        tbody tr:nth-child(even) { background: rgba(0,0,0,0.08); }
        .light-mode th { color: #475569; border-bottom-color: #c5cdd8; background: #f1f5f9; }
        .light-mode td { color: #0f172a; border-bottom-color: #dce1ea; }
        .light-mode tbody tr:nth-child(even) { background: rgba(0,0,0,0.02); }

        /* Print */
        @media print {
            @page { size: A4 portrait; margin: 12mm 10mm 15mm 10mm; }
            html, body { background: #fff !important; color: #0f172a !important; font-size: 9pt !important; line-height: 1.4 !important; overflow: visible !important; height: auto !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
            .container, .hero-section, .intel-section, .card, .module-group, .finding-card, .finding-body { overflow: visible !important; max-height: none !important; height: auto !important; }
            .top-nav, nav, .sidebar, .scroll-progress, .copy-btn, .export-btn, .filter-controls, .search-box, .collapse-btn, #theme-toggle, .btn, button, input, [id^="chat-panel"] { display: none !important; }
            .finding-body, .intel-card-content, .collapsible-content { display: block !important; visibility: visible !important; opacity: 1 !important; max-height: none !important; }
            .card, .intel-card { background: #fff !important; color: #0f172a !important; border: 1px solid #c5cdd8 !important; box-shadow: none !important; padding: 10px !important; break-inside: avoid !important; page-break-inside: avoid !important; }
            code, pre, .evidence { background: #f1f5f9 !important; color: #0f172a !important; border: 1px solid #c5cdd8 !important; }
        }
    </style>
</head>
<body>
    <!-- Data Bridge for JS -->
    <script id="chart-data-json" type="application/json">
        {{ chart_data | safe }}
    </script>
    <script id="d3-data-json" type="application/json">
        {{ d3_data | safe }}
    </script>

    <!-- Core Global Script Engine (Loaded Immediately at Top) -->
    <script>
        // Safe LocalStorage helpers
        window.getStorage = function(key, defaultVal) {
            try { return localStorage.getItem(key) || defaultVal; }
            catch(e) { return defaultVal; }
        };
        window.setStorage = function(key, val) {
            try { localStorage.setItem(key, val); }
            catch(e) {}
        };

        // Copy Text Helper (Supports Clipboard API and fallback for file:// URLs)
        window.copyText = function(text, btn) {
            if (!text) return;
            function showSuccess() {
                if (btn) {
                    const orig = btn.innerHTML;
                    btn.innerHTML = '&#10003; Copied!';
                    setTimeout(() => { btn.innerHTML = orig; }, 2000);
                }
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(showSuccess).catch(() => {
                    fallbackCopy(text);
                });
            } else {
                fallbackCopy(text);
            }
            function fallbackCopy(str) {
                const ta = document.createElement('textarea');
                ta.value = str;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try {
                    document.execCommand('copy');
                    showSuccess();
                } catch(e) {
                    prompt('Copy text:', str);
                }
                document.body.removeChild(ta);
            }
        };

        // Suppressed Findings Drawer Toggle
        window.toggleFPDetails = function(id) {
            const el = document.getElementById(id);
            if (!el) return;
            if (el.style.display === 'none' || el.classList.contains('hidden') || getComputedStyle(el).display === 'none') {
                el.classList.remove('hidden');
                el.style.display = 'table-row';
            } else {
                el.classList.add('hidden');
                el.style.display = 'none';
            }
        };

        // Suppressed Findings Category Filter
        window.setFPFilter = function(type) {
            const buttons = document.querySelectorAll('#fp-filter-buttons button');
            buttons.forEach(btn => {
                btn.style.background = 'var(--surface)';
                btn.style.color = 'var(--text)';
                btn.style.borderColor = 'var(--border)';
            });
            const activeBtn = document.getElementById('fp-btn-' + type);
            if (activeBtn) {
                activeBtn.style.background = 'var(--accent)';
                activeBtn.style.color = '#ffffff';
                activeBtn.style.borderColor = 'var(--accent)';
            }

            const rows = document.querySelectorAll('#fp-table tbody tr.fp-row');
            const details = document.querySelectorAll('#fp-table tbody tr.fp-detail-row');
            details.forEach(d => { d.classList.add('hidden'); d.style.display = 'none'; });

            rows.forEach(row => {
                const rowType = row.getAttribute('data-type');
                if (type === 'all' || rowType === type) {
                    row.style.display = 'table-row';
                } else {
                    row.style.display = 'none';
                }
            });
        };

        // Suppressed Findings Live Search
        window.filterSuppressedFindings = function(query) {
            const q = (query || '').toLowerCase().trim();
            const rows = document.querySelectorAll('#fp-table tbody tr.fp-row');
            rows.forEach(row => {
                const searchData = (row.getAttribute('data-search') || '').toLowerCase();
                if (!q || searchData.indexOf(q) !== -1) {
                    row.style.display = 'table-row';
                } else {
                    row.style.display = 'none';
                }
            });
        };

        // Initialize Global State
        window.state = {
            theme: window.getStorage('phantomscan_theme', 'dark'),
            currentFilter: 'all',
            searchQuery: '',
            chartData: {},
            d3Data: { nodes: [], links: [] }
        };

        try {
            const chartEl = document.getElementById('chart-data-json');
            if (chartEl && chartEl.textContent) {
                window.state.chartData = JSON.parse(chartEl.textContent);
            }
        } catch(e) {}

        try {
            const d3El = document.getElementById('d3-data-json');
            if (d3El && d3El.textContent) {
                window.state.d3Data = JSON.parse(d3El.textContent);
            }
        } catch(e) {}

        // Apply saved theme immediately
        if (window.state.theme === 'light') {
            document.documentElement.classList.add('light-mode');
        }

        // Theme Toggle Handler
        window.toggleTheme = function() {
            window.state.theme = window.state.theme === 'dark' ? 'light' : 'dark';
            if (window.state.theme === 'light') {
                document.documentElement.classList.add('light-mode');
            } else {
                document.documentElement.classList.remove('light-mode');
            }
            window.setStorage('phantomscan_theme', window.state.theme);
        };

        window.toggleCollapsible = function(headerEl) {
            if (!headerEl) return;
            const content = headerEl.nextElementSibling;
            if (content) {
                content.classList.toggle('hidden');
            }
        };

        window.printReport = function() {
            document.querySelectorAll('.finding-body, .intel-card-content, .collapsible-content').forEach(el => {
                el.classList.remove('hidden');
            });
            document.querySelectorAll('.finding-card, .module-group').forEach(el => {
                el.style.display = 'block';
            });
            setTimeout(() => { window.print(); }, 150);
        };

        window.exportJSON = function() {
            const reportData = {
                version: "{{ report_version }}",
                target: "{{ scan.target }}",
                score: {{ score.value | default(0) }},
                grade: "{{ score.grade | default('N/A') }}",
                timestamp: new Date().toISOString(),
                findings_count: {{ findings | length }},
                suppressed_count: {{ fp_log | length }}
            };
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(reportData, null, 2));
            const a = document.createElement('a');
            a.href = dataStr;
            a.download = "phantomscan_report_{{ scan.target }}.json";
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        };
    </script>

